---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SEO from '../components/SEO.astro';
import { getSettings } from '../utils/strapi';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Prvi Balkan - Tehnički Pregled Vozila',
  description = 'Profesionalni tehnički pregled vozila sa 3 lokacije u Beogradu.',
  image,
} = Astro.props;

const settings = await getSettings();
const logo = settings?.logo;

// Build canonical URL from Astro.site + current path
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Get current URL path for breadcrumbs
let currentPath = new URL(Astro.request.url).pathname;

// Remove base path prefix (/tehnicki_pregled) if present
const baseUrl = import.meta.env.BASE_URL;
if (baseUrl && baseUrl !== '/' && currentPath.startsWith(baseUrl)) {
  currentPath = currentPath.slice(baseUrl.length) || '/';
}
---

<!doctype html>
<html lang="sr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <link
      rel="icon"
      type="image/x-icon"
      href={`${import.meta.env.BASE_URL}favicon.ico`}
    />
    <meta name="description" content={description} />
    <title>{title}</title>
    <SEO {title} {description} {image} {canonicalUrl} />

    <!-- Optimized font loading with preload for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class="bg-white text-gray-900">
    <Header logo={logo} />
    <Breadcrumbs currentPath={currentPath} />
    <slot />
  </body>
</html>

<script>
  import { injectSpeedInsights } from '@vercel/speed-insights';
  import { inject } from '@vercel/analytics';
  injectSpeedInsights();
  inject();

  // Samsung Internet (and some other mobile browsers) don't always trigger
  // the phone dialer from <a href="tel:...">. This click handler forces
  // window.location.href which reliably opens the dialer on all browsers.
  document
    .querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]')
    .forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        window.location.href = link.href;
      });
    });
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', sans-serif;
  }
</style>
