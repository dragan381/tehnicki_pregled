---
import Icon from './Icon.astro';
import { getPath } from '../utils/navigation';

const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  order: number;
  name: string;
  address: string;
  slug: string;
  phone: string;
}

const { order, name, address, slug, phone } = Astro.props;
---

<div class="text-left">
  <div
    class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1 text-xs uppercase tracking-[0.3em] text-white/80"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
    Lokacija {order}
  </div>
  <h2
    class="text-2xl lg:text-4xl font-bold text-accent mt-2 lg:mt-4 mb-1 lg:mb-2 drop-shadow"
  >
    {name}
  </h2>
  <div class="flex items-center mb-1">
    <a
      href={getPath(`/lokacije/${slug}`, baseUrl)}
      class="inline-flex items-center text-accent hover:text-orange-600"
    >
      <Icon name="location_on" size="md" class="mb-1" />
      <p class="text-sm lg:text-base text-white/80 max-w-sm">
        {address}
      </p>
    </a>
  </div>
  <a
    href={`tel:${phone}`}
    class="inline-block text-sm lg:text-base text-white/80 max-w-sm hover:text-accent mb-2 lg:mb-6"
    >{phone}</a
  >
</div>
<a
  href={getPath(`/lokacije/${slug}`, baseUrl)}
  class="iline-block mb-1 relative z-20 inline-flex items-center gap-2 bg-white text-primary font-semibold py-2.5 px-6 rounded-full shadow-lg hover:shadow-xl transition transform hover:-translate-y-0.5"
>
  Zakaži
  <Icon name="chevron_right" class="text-accent" />
</a>
