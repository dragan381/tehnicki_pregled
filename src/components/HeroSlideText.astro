---
import Icon from './Icon.astro';
import { getPath } from '../utils/navigation';

const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  order: number;
  name: string;
  address: string;
  slug: string;
  phone: string;
}

const { order, name, address, slug, phone } = Astro.props;
const phoneHref = phone.replace(/[\s\-\(\)]/g, '');
---

<div class="text-center md:text-left -mt-12 md:mt-0">
  <!-- Location badge + title inline on mobile, stacked on tablet/desktop -->
  <div
    class="flex items-center justify-center md:justify-start gap-2 md:gap-0 md:flex-col md:items-start"
  >
    <div class="flex-col gap-0 items-start">
      <div
        class="inline-flex items-center gap-1.5 md:gap-2 rounded-full bg-white/15 px-2 py-0.5 md:px-4 md:py-1 text-[0.4rem] md:text-xs uppercase tracking-[0.2em] md:tracking-[0.3em] text-white/80 leading-none"
      >
        <span class="h-1 w-1 md:h-1.5 md:w-1.5 rounded-full bg-accent"></span>
        <span class="translate-y-[0.5px]">Lokacija {order}</span>
      </div>
      <h2
        class="text-xl md:text-3xl lg:text-6xl font-bold text-accent md:mt-4 mb-0 md:mb-2 drop-shadow"
      >
        {name}
      </h2>
    </div>
  </div>
  <div class="flex items-center justify-center md:justify-start mb-1">
    <a
      href={getPath(`/lokacije/${slug}`, baseUrl)}
      class="inline-flex items-center text-accent hover:text-orange-600"
    >
      <Icon name="location_on" size="md" class="mb-1" />
      <p class="text-lg md:text-xl lg:text-3xl text-white/80">
        {address}
      </p>
    </a>
  </div>
  <a
    href={`tel:${phoneHref}`}
    class="inline-block text-lg md:text-xl lg:text-3xl text-white/80 max-w-sm hover:text-accent mb-2 md:mb-6"
    >{phone}</a
  >
  <div class="flex justify-center md:justify-start mt-2 md:mt-0">
    <a
      href={getPath(`/lokacije/${slug}`, baseUrl)}
      class="inline-flex items-center gap-2 bg-white text-primary font-semibold py-2 px-5 md:py-2.5 md:px-6 rounded-full shadow-lg hover:shadow-xl transition transform hover:-translate-y-0.5 relative z-20"
    >
      Zakaži
      <Icon name="chevron_right" class="text-accent" />
    </a>
  </div>
</div>
