---
import { Image } from 'astro:assets';
import { getStrapiImageUrl } from '../utils/strapi';
import type { StrapiMedia } from '../types/strapi';

export interface Props {
  name: string;
  image?: StrapiMedia;
}

const { name, image } = Astro.props;
---

<div class="relative flex justify-center lg:justify-end overflow-hidden">
  {image?.url ? (
    <div class="hero-slide-img relative w-full max-w-[280px] md:max-w-lg">
      <Image
        src={getStrapiImageUrl(image)}
        alt={name}
        width={520}
        height={340}
        class="w-full h-36 md:h-72 object-cover rounded-2xl shadow-2xl"
      />
      <!-- soft left-fade so image blends into the hero gradient -->
      <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-primary/60 via-transparent to-transparent pointer-events-none"></div>
      <!-- soft top+bottom fade -->
      <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-primary/30 via-transparent to-primary/30 pointer-events-none"></div>
    </div>
  ) : (
    <div class="w-full max-w-[280px] md:max-w-lg h-36 md:h-72 rounded-2xl bg-white/20 flex items-center justify-center text-white/70">
      No image
    </div>
  )}
</div>

<style>
  .hero-slide-img {
    -webkit-mask-image: radial-gradient(ellipse 90% 85% at 60% 50%, black 50%, transparent 100%);
    mask-image: radial-gradient(ellipse 90% 85% at 60% 50%, black 50%, transparent 100%);
  }
</style>
