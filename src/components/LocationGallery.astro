---
import { getStrapiImageUrl } from '../utils/strapi';
import { Image } from 'astro:assets';
import type { StrapiMedia } from '../types/strapi';

interface Props {
  image?: StrapiMedia;
  gallery?: StrapiMedia[];
  locationName: string;
}

const { image, gallery, locationName } = Astro.props;

// Build unified images array from gallery + fallback single image
const allImages: { url: string; alt: string; width: number; height: number }[] =
  [];

if (gallery && gallery.length > 0) {
  for (const img of gallery) {
    const url = getStrapiImageUrl(img);
    if (url) {
      allImages.push({
        url,
        alt: img.alternativeText || `${locationName} - fotografija`,
        width: img.width || 800,
        height: img.height || 600,
      });
    }
  }
}

// Fallback to single image if no gallery
if (allImages.length === 0 && image) {
  const url = getStrapiImageUrl(image);
  if (url) {
    allImages.push({
      url,
      alt: image.alternativeText || `Lokacija ${locationName}`,
      width: image.width || 800,
      height: image.height || 500,
    });
  }
}

const count = allImages.length;
---

{
  count > 0 && (
    <div class="location-gallery" data-count={count}>
      {/* Lightbox overlay */}
      <div
        id="gallery-lightbox"
        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm"
      >
        <button
          id="lightbox-close"
          class="absolute top-4 right-4 text-white/80 hover:text-white transition z-10 cursor-pointer"
          aria-label="Zatvori"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
        <button
          id="lightbox-prev"
          class="absolute left-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white transition z-10 cursor-pointer"
          aria-label="Prethodna"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-10 w-10"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"
            />
          </svg>
        </button>
        <button
          id="lightbox-next"
          class="absolute right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white transition z-10 cursor-pointer"
          aria-label="Sledeća"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-10 w-10"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-h-[85vh] max-w-[90vw] rounded-lg object-contain"
        />
        <div
          id="lightbox-counter"
          class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white/70 text-sm"
        />
      </div>

      {/* Single image — full card */}
      {count === 1 && (
        <div
          class="rounded-xl overflow-hidden shadow-lg cursor-pointer group"
          data-gallery-item="0"
        >
          <Image
            src={allImages[0].url}
            alt={allImages[0].alt}
            width={allImages[0].width}
            height={allImages[0].height}
            class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </div>
      )}

      {/* Two images — side by side */}
      {count === 2 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {allImages.map((img, i) => (
            <div
              class="rounded-xl overflow-hidden shadow-lg cursor-pointer group"
              data-gallery-item={i}
            >
              <Image
                src={img.url}
                alt={img.alt}
                width={img.width}
                height={img.height}
                class="w-full h-56 sm:h-64 object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
          ))}
        </div>
      )}

      {/* Three images — featured + two side */}
      {count === 3 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 sm:grid-rows-2 gap-3 sm:h-[28rem]">
          <div
            class="sm:row-span-2 rounded-xl overflow-hidden shadow-lg cursor-pointer group"
            data-gallery-item="0"
          >
            <Image
              src={allImages[0].url}
              alt={allImages[0].alt}
              width={allImages[0].width}
              height={allImages[0].height}
              class="w-full h-56 sm:h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          {allImages.slice(1).map((img, i) => (
            <div
              class="rounded-xl overflow-hidden shadow-lg cursor-pointer group"
              data-gallery-item={i + 1}
            >
              <Image
                src={img.url}
                alt={img.alt}
                width={img.width}
                height={img.height}
                class="w-full h-56 sm:h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
          ))}
        </div>
      )}

      {/* Four images — 2x2 grid */}
      {count === 4 && (
        <div class="grid grid-cols-2 gap-3">
          {allImages.map((img, i) => (
            <div
              class="rounded-xl overflow-hidden shadow-lg cursor-pointer group"
              data-gallery-item={i}
            >
              <Image
                src={img.url}
                alt={img.alt}
                width={img.width}
                height={img.height}
                class="w-full h-40 sm:h-48 object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
          ))}
        </div>
      )}

      {/* Five or more — featured large + grid of rest with "show more" overlay */}
      {count >= 5 && (
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div
            class="col-span-2 row-span-2 rounded-xl overflow-hidden shadow-lg cursor-pointer group"
            data-gallery-item="0"
          >
            <Image
              src={allImages[0].url}
              alt={allImages[0].alt}
              width={allImages[0].width}
              height={allImages[0].height}
              class="w-full h-56 sm:h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>
          {allImages.slice(1, 5).map((img, i) => (
            <div
              class:list={[
                'rounded-xl overflow-hidden shadow-lg cursor-pointer group relative',
                i === 3 && count > 5 ? '' : '',
              ]}
              data-gallery-item={i + 1}
            >
              <Image
                src={img.url}
                alt={img.alt}
                width={img.width}
                height={img.height}
                class="w-full h-[calc(50%-0.375rem)] sm:h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              {i === 3 && count > 5 && (
                <div class="absolute inset-0 bg-black/50 flex items-center justify-center transition-colors group-hover:bg-black/40">
                  <span class="text-white text-xl font-bold">+{count - 5}</span>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  )
}

<script define:vars={{ allImages }}>
  // Make images data available to the client script
  window.__galleryImages = allImages;
</script>

<script>
  function initGallery() {
    const images = (window as any).__galleryImages as Array<{
      url: string;
      alt: string;
    }>;
    if (!images || images.length === 0) return;

    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById(
      'lightbox-img',
    ) as HTMLImageElement | null;
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const lightboxCounter = document.getElementById('lightbox-counter');
    if (!lightbox || !lightboxImg) return;

    let currentIndex = 0;

    function show(index: number) {
      currentIndex = ((index % images.length) + images.length) % images.length;
      lightboxImg!.src = images[currentIndex].url;
      lightboxImg!.alt = images[currentIndex].alt;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
      }
      // Hide nav arrows for single image
      if (lightboxPrev)
        lightboxPrev.style.display = images.length <= 1 ? 'none' : '';
      if (lightboxNext)
        lightboxNext.style.display = images.length <= 1 ? 'none' : '';
      if (lightboxCounter)
        lightboxCounter.style.display = images.length <= 1 ? 'none' : '';
    }

    function open(index: number) {
      show(index);
      lightbox!.classList.remove('hidden');
      lightbox!.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.classList.add('hidden');
      lightbox!.classList.remove('flex');
      document.body.style.overflow = '';
    }

    // Click on gallery items
    document.querySelectorAll('[data-gallery-item]').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = parseInt(el.getAttribute('data-gallery-item') || '0', 10);
        open(idx);
      });
    });

    lightboxClose?.addEventListener('click', close);
    lightboxPrev?.addEventListener('click', () => show(currentIndex - 1));
    lightboxNext?.addEventListener('click', () => show(currentIndex + 1));

    // Close on backdrop click
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(currentIndex - 1);
      if (e.key === 'ArrowRight') show(currentIndex + 1);
    });
  }

  // Run on initial load and on Astro page transitions
  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
