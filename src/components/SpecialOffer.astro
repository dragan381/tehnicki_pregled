---
import { getPath } from '../utils/navigation';
import OfferBadge from './OfferBadge.astro';
import '../styles/special-offer.css';

const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  badgeTitle?: string;
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
  showButton?: boolean;
}

const { badgeTitle, title, description, buttonText, buttonLink, showButton } =
  Astro.props as Props;
---

<section class="special-offer-section relative py-4 overflow-hidden -mt-0">
  <!-- Dark translucent glass background -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-800/85 to-slate-900/90 backdrop-blur-sm"
  >
  </div>
  <!-- Top fade from Hero -->
  <div
    class="absolute top-0 left-0 right-0 h-8 bg-gradient-to-b from-slate-900/60 to-transparent"
  >
  </div>
  <!-- Subtle shimmer line -->
  <div class="absolute inset-0 overflow-hidden">
    <div
      class="shimmer-line absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-accent/50 to-transparent"
    >
    </div>
    <div
      class="shimmer-line absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent"
    >
    </div>
  </div>

  <div
    class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-center"
  >
    <div
      class="inline-flex flex-col md:flex-row items-center gap-4 md:gap-6 lg:gap-8 lg:translate-x-14"
    >
      <!-- Badge -->
      <OfferBadge title={badgeTitle} />

      <!-- Offer Content (left-aligned text) -->
      <div class="text-left max-w-xl">
        <div class="flex items-center gap-3 mb-4">
          <!-- Title in CSS ribbon -->
          <div class="offer-ribbon relative inline-block">
            <span
              class="relative z-10 inline-block px-5 py-1 text-sm md:text-base lg:text-lg font-extrabold uppercase tracking-widest text-white"
            >
              {title}
            </span>
          </div>
          <!-- Action Button -->
          {
            showButton && (
              <a
                href={getPath(buttonLink, baseUrl)}
                class="offer-button px-4 py-2 text-xs md:text-sm font-semibold uppercase tracking-wide text-white border-2 border-orange-500 rounded hover:bg-orange-500/10 transition-colors"
              >
                {buttonText}
              </a>
            )
          }
        </div>
        <p
          class="text-xs md:text-sm italic text-white/80 leading-relaxed drop-shadow"
        >
          {description}
        </p>
      </div>
    </div>
  </div>
</section>
