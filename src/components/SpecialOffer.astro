---
import Icon from './Icon.astro';
import { getPath } from '../utils/navigation';

const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  offerTitle?: string;
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
}

const {
  offerTitle = 'Specijalna\nponuda',
  title,
  description,
  buttonText,
  buttonLink,
} = Astro.props as Props;
---

<section class="special-offer-section relative py-4 overflow-hidden -mt-0">
  <!-- Dark translucent glass background -->
  <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-800/85 to-slate-900/90 backdrop-blur-sm"></div>
  <!-- Top fade from Hero -->
  <div class="absolute top-0 left-0 right-0 h-8 bg-gradient-to-b from-slate-900/60 to-transparent"></div>
  <!-- Subtle shimmer line -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="shimmer-line absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-accent/50 to-transparent"></div>
    <div class="shimmer-line absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-center">
    <div class="inline-flex flex-col lg:flex-row items-center gap-4 lg:gap-8 lg:translate-x-14">
      
      <!-- Badge -->
      <div class="flex-shrink-0">
        <div class="relative w-20 h-20 flex items-center justify-center" style="perspective: 1000px;">
          <div class="offer-badge absolute inset-0 bg-gradient-to-br from-accent to-orange-600 rounded-lg shadow-[0_0_20px_rgba(249,115,22,0.4)] transform -rotate-12 flex items-center justify-center">
            <div class="text-center">
              <div class="text-xs md:text-sm font-black text-white leading-tight whitespace-pre-line drop-shadow-lg">
                {offerTitle}
              </div>
            </div>
          </div>
          <div class="offer-circle absolute -top-2 -left-2 bg-white rounded-full w-5 h-5 shadow-lg flex items-center justify-center">
            <div class="w-3 h-3 rounded-full border-2 border-accent"></div>
          </div>
        </div>
      </div>

      <!-- Offer Content (left-aligned text) -->
      <div class="text-left max-w-xl">
        <h2 class="text-base md:text-lg lg:text-xl font-bold italic text-accent mb-1 drop-shadow-md tracking-wide">
          {title}
        </h2>
        <p class="text-xs md:text-sm italic text-white/80 leading-relaxed drop-shadow">
          {description}
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes badge-pulse {
    0%, 100% {
      transform: scale(1) rotateZ(-12deg);
    }
    50% {
      transform: scale(1.12) rotateZ(-12deg);
    }
  }

  @keyframes shimmer {
    0% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0.3;
    }
  }

  .offer-badge {
    animation: badge-pulse 2s ease-in-out infinite;
  }

  @keyframes circle-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.3);
    }
  }

  .offer-circle {
    animation: circle-pulse 2s ease-in-out infinite;
  }

  .shimmer-line {
    animation: shimmer 3s ease-in-out infinite;
  }

  .special-offer-section {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
</style>
