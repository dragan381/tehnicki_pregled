---
import Icon from './Icon.astro';
import { getPath } from '../utils/navigation';

const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  offerTitle?: string;
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
}

const {
  offerTitle = 'Special\nOFFER!',
  title,
  description,
  buttonText,
  buttonLink,
} = Astro.props as Props;
---

<section class="relative py-16 md:py-24 overflow-hidden">
  <!-- Diagonal pattern background -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary via-secondary to-primary opacity-95"></div>
  <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 2px, rgba(255,255,255,0.02) 2px, rgba(255,255,255,0.02) 4px);"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-16">
      
      <!-- Left: Red Offer Badge (Tilted) -->
      <div class="flex-shrink-0 w-full lg:w-auto flex justify-center">
        <div class="relative w-56 h-56 flex items-center justify-center" style="perspective: 1000px;">
          <!-- Red tilted box with clip-path -->
          <div class="absolute inset-0 bg-gradient-to-br from-red-500 to-red-700 rounded-2xl shadow-2xl transform -rotate-12 flex items-center justify-center">
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-black text-white leading-tight whitespace-pre-line drop-shadow-lg">
                {offerTitle}
              </div>
            </div>
          </div>
          <!-- Decorative circle on top-left corner -->
          <div class="absolute -top-4 -left-4 bg-white rounded-full w-12 h-12 shadow-lg flex items-center justify-center">
            <div class="w-8 h-8 rounded-full border-2 border-red-500"></div>
          </div>
        </div>
      </div>

      <!-- Right: Offer Content -->
      <div class="flex-1 text-center lg:text-left max-w-xl">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 drop-shadow">
          {title}
        </h2>
        <p class="text-base md:text-lg text-white/90 mb-8 leading-relaxed drop-shadow">
          {description}
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href={getPath(buttonLink, baseUrl)}
            class="group relative inline-flex items-center gap-3 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-bold py-4 px-8 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
          >
            {buttonText}
            <Icon name="arrow_forward" class="w-5 h-5 transition-transform group-hover:scale-110" />
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Optional: Add hover animation to the offer badge */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) rotateZ(-12deg);
    }
    50% {
      transform: translateY(-8px) rotateZ(-12deg);
    }
  }

  section:hover .offer-badge {
    animation: float 3s ease-in-out infinite;
  }
</style>
