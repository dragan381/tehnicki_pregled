---
import { getPath } from '../utils/navigation';
const baseUrl = import.meta.env.BASE_URL;
---

<section class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-primary">Naše Usluge</h2>
    <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">Pružamo kompletan spektar usluga tehničkog pregleda vozila sa visoko osposobljenim tehničarima i modernom opremom.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300 animate-slideUp group">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-lg bg-gradient-to-br from-blue-100 to-blue-50 mb-4 group-hover:bg-gradient-to-tr group-hover:shadow-glow transition duration-300">
          <span class="material-icons text-3xl text-primary group-hover:animate-iconFloat">miscellaneous_services</span>
        </div>
        <h3 class="text-xl font-bold mb-2 text-primary">Tehnički Pregled</h3>
        <p class="text-gray-600 mb-4">Kompletan tehnički pregled vozila prema zvaničnim standardima sa detaljnim izveštajem.</p>
        <a href={getPath('/usluge', baseUrl)} class="inline-flex items-center text-accent hover:text-orange-600 transition group">
          Saznaj više
          <span class="material-icons text-sm ml-2 group-hover:translate-x-1 transition">arrow_forward</span>
        </a>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300 animate-slideUp group" style="animation-delay: 0.1s">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-lg bg-gradient-to-br from-orange-100 to-orange-50 mb-4 group-hover:bg-gradient-to-tr group-hover:shadow-glow-accent transition duration-300">
          <span class="material-icons text-3xl text-accent group-hover:animate-spin">description</span>
        </div>
        <h3 class="text-xl font-bold mb-2 text-primary">Registracija Vozila</h3>
        <p class="text-gray-600 mb-4">Pomoć pri registraciji vozila i pripremi svih potrebnih dokumenata za nadležne organe.</p>
        <a href={getPath('/usluge', baseUrl)} class="inline-flex items-center text-accent hover:text-orange-600 transition group">
          Saznaj više
          <span class="material-icons text-sm ml-2 group-hover:translate-x-1 transition">arrow_forward</span>
        </a>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300 animate-slideUp group" style="animation-delay: 0.2s">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-lg bg-gradient-to-br from-green-100 to-green-50 mb-4 group-hover:bg-gradient-to-tr group-hover:shadow-lg transition duration-300 group-hover:shadow-green-500/30">
          <span class="material-icons text-3xl text-green-600 group-hover:animate-bounce">security</span>
        </div>
        <h3 class="text-xl font-bold mb-2 text-primary">Osiguranje</h3>
        <p class="text-gray-600 mb-4">Konsultacije i pomoć pri sklapanju osiguranja vozila sa našim partnerima.</p>
        <a href="/usluge" class="inline-flex items-center text-accent hover:text-orange-600 transition group">
          Saznaj više
          <span class="material-icons text-sm ml-2 group-hover:translate-x-1 transition">arrow_forward</span>
        </a>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-xl transition duration-300 animate-slideUp group" style="animation-delay: 0.3s">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-lg bg-gradient-to-br from-purple-100 to-purple-50 mb-4 group-hover:bg-gradient-to-tr group-hover:shadow-lg transition duration-300 group-hover:shadow-purple-500/30">
          <span class="material-icons text-3xl text-purple-600 group-hover:animate-pulse">smartphone</span>
        </div>
        <h3 class="text-xl font-bold mb-2 text-primary">Online Poruke</h3>
        <p class="text-gray-600 mb-4">Brz odgovor na sve tvoje pitanje preko različitih kanala komunikacije.</p>
        <a href={getPath('/kontakt', baseUrl)} class="inline-flex items-center text-accent hover:text-orange-600 transition group">
          Kontaktiraj nas
          <span class="material-icons text-sm ml-2 group-hover:translate-x-1 transition">arrow_forward</span>
        </a>
      </div>
    </div>

    <div class="text-center mt-12">
      <a href={getPath('/usluge', baseUrl)} class="inline-block bg-gradient-to-r from-accent to-orange-500 hover:from-orange-600 hover:to-red-500 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105">
        <span class="inline-flex items-center gap-2">
          <span class="material-icons">bolt</span>
          Sve Usluge
        </span>
      </a>
    </div>
  </div>
</section>
