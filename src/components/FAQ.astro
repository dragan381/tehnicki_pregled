---
import Icon from './Icon.astro';
import { getPath } from '../utils/navigation';
import { getFAQs, blocksToText } from '../utils/strapi';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const allFaqs = await getFAQs();
const faqs = limit ? allFaqs.slice(0, limit) : allFaqs;
const hasMore = limit ? allFaqs.length > limit : false;
---

<section class="py-16 bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2
      class="text-3xl md:text-4xl font-bold text-center mb-4 text-primary animate-fadeIn"
    >
      Često Postavljana Pitanja
    </h2>
    <p
      class="text-center text-gray-600 mb-12 animate-slideUp"
      style="animation-delay: 0.1s"
    >
      Odgovori na pitanja koja vas zanimaju o našim uslugama.
    </p>

    <div class="space-y-4 animate-slideUp" style="animation-delay: 0.2s">
      {
        faqs.map((faq, index) => (
          <details
            class="bg-white rounded-lg shadow-md hover:shadow-lg transition duration-300 p-6 group cursor-pointer"
            open={index === 0}
          >
            <summary class="flex items-center justify-between font-bold text-primary">
              <span class="flex items-center gap-3">
                <Icon name={faq.icon || 'help'} size="lg" />
                {faq.question}
              </span>
              <Icon
                name="expand_more"
                class="transition duration-300 group-open:rotate-180"
              />
            </summary>
            <p class="text-gray-600 mt-4 ml-10">{blocksToText(faq.answer)}</p>
          </details>
        ))
      }
    </div>

    <div class="text-center mt-12">
      {
        hasMore ? (
          <a
            href={getPath('/cesto-pitana-pitanja', baseUrl)}
            class="inline-block bg-gradient-to-r from-accent to-orange-500 hover:from-orange-600 hover:to-red-500 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105"
          >
            <span class="inline-flex items-center gap-2">
              <Icon name="help" />
              Pogledaj sva pitanja
            </span>
          </a>
        ) : (
          <>
            <p class="text-gray-600 mb-4">Još pitanja?</p>
            <a
              href={getPath('/kontakt', baseUrl)}
              class="inline-block bg-gradient-to-r from-accent to-orange-500 hover:from-orange-600 hover:to-red-500 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105"
            >
              <span class="inline-flex items-center gap-2">
                <Icon name="mail" />
                Kontaktiraj nas
              </span>
            </a>
          </>
        )
      }
    </div>
  </div>
</section>
