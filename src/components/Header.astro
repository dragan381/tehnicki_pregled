---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { getPath } from '../utils/navigation';
import { getStrapiImageUrl, getSettings, getLocations } from '../utils/strapi';
import type { StrapiMedia } from '../types/strapi';
const baseUrl = import.meta.env.BASE_URL;

const strapiUrl = import.meta.env.STRAPI_URL || 'http://localhost:1337';
const locations = await getLocations();
const locationOptions = locations.map((l) => ({
  label: `${l.name} - ${l.address}`,
  email: l.email,
}));

const STRAPI_URL = import.meta.env.STRAPI_URL || 'http://localhost:1337';

interface Props {
  logo?: StrapiMedia;
}

const { logo } = Astro.props;

// Use Strapi's small format for the header logo (smaller download at build time)
function getLogoUrl(media: StrapiMedia | undefined): string {
  if (!media) return '';
  const small = media.formats?.small;
  if (small) {
    return small.url.startsWith('http')
      ? small.url
      : `${STRAPI_URL}${small.url}`;
  }
  return getStrapiImageUrl(media);
}

const logoUrl = getLogoUrl(logo);
const logoWidth = logo?.formats?.small?.width || logo?.width || 200;
const logoHeight = logo?.formats?.small?.height || logo?.height || 48;

const links = [
  { href: '/', label: 'Početna', icon: 'home' },
  { href: '/usluge', label: 'Usluge', icon: 'check_circle' },
  { href: '/lokacije', label: 'Lokacije', icon: 'location_on' },
  { href: '/blog', label: 'Blog', icon: 'article' },
  { href: '/cesto-pitana-pitanja', label: 'FAQ', icon: 'help' },
  { href: '/o-nama', label: 'O Nama', icon: 'info' },
  { href: '/kontakt', label: 'Kontakt', icon: 'phone' },
];

const isHomePage =
  Astro.url.pathname === '/' ||
  Astro.url.pathname === baseUrl ||
  Astro.url.pathname === baseUrl + '/';
const shouldHaveDarkBg = !isHomePage;
---

<header class="sticky top-0 z-50" id="header">
  <div
    class={`absolute inset-0 backdrop-blur-lg transition-all duration-300 ${shouldHaveDarkBg ? 'bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 shadow-md' : 'bg-white'}`}
    id="header-bg"
  >
  </div>
  <nav class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0">
        <a
          href={getPath('/', baseUrl)}
          class="text-2xl font-bold tracking-tight text-primary hover:text-accent transition duration-300 animate-fadeIn"
          id="logo"
        >
          {
            logo && logoUrl ? (
              <Image
                src={logoUrl}
                alt={logo.alternativeText || 'Prvi Balkan Logo'}
                width={logoWidth}
                height={logoHeight}
                id="logo-img"
                class={`h-10 sm:h-12 w-auto object-contain transition-[filter] duration-300 ${shouldHaveDarkBg ? 'brightness-0 invert' : ''}`}
              />
            ) : (
              <>
                <span class="text-accent">Prvi</span>
                <span class="text-primary ml-1">Balkan</span>
              </>
            )
          }
        </a>
      </div>

      {/* Mobile calculator button - between logo and hamburger */}
      <div class="md:hidden flex-1 flex justify-end mr-3">
        <button
          type="button"
          id="open-calculator-btn-mobile-header"
          class="bg-gradient-to-r from-accent to-orange-500 hover:from-orange-600 hover:to-red-500 text-white px-3 py-1.5 rounded-lg font-semibold text-xs transition duration-300 transform hover:scale-105 hover:shadow-xl cursor-pointer"
        >
          Kalkulator
        </button>
      </div>

      <div class="hidden md:flex space-x-1">
        {
          links.map((link) => (
            <a
              href={getPath(link.href, baseUrl)}
              class={`group relative px-4 py-2 transition duration-300 flex items-center gap-2 font-medium text-sm tracking-wide ${shouldHaveDarkBg ? 'text-slate-300 hover:text-white' : 'text-gray-700 hover:text-primary'}`}
              id="nav-link"
            >
              <span>{link.label}</span>
              <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-accent to-orange-400 transition-all duration-300 group-hover:w-full" />
            </a>
          ))
        }

        <button
          type="button"
          id="open-calculator-btn"
          class="ml-4 bg-gradient-to-r from-accent to-orange-500 hover:from-orange-600 hover:to-red-500 text-white px-6 py-2 rounded-lg font-semibold transition duration-300 transform hover:scale-105 hover:shadow-xl flex items-center gap-2 group cursor-pointer"
        >
          Kalkulator registracije
        </button>
      </div>

      <div class="md:hidden">
        <button
          class={`hover:text-primary transition duration-300 ${shouldHaveDarkBg ? 'text-white' : 'text-gray-700'}`}
          id="mobile-menu-btn"
          aria-label="Open menu"
        >
          <Icon name="menu" />
        </button>
      </div>
    </div>
  </nav>

  {/* Mobile menu */}
  <div
    id="mobile-menu"
    class="relative z-10 md:hidden bg-white border-t border-gray-200 overflow-hidden transition-all duration-300 ease-out max-h-0 opacity-0"
  >
    <div class="px-2 pt-2 pb-3 space-y-1">
      {
        links.map((link) => (
          <a
            href={getPath(link.href, baseUrl)}
            class="mobile-menu-link flex items-center gap-2 px-3 py-2 text-gray-700 hover:bg-blue-50 hover:text-primary rounded-lg transition duration-300"
          >
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        id="open-calculator-btn-mobile"
        class="mobile-menu-link flex items-center gap-2 px-3 py-2 bg-gradient-to-r from-accent to-orange-500 text-white rounded-lg font-semibold hover:from-orange-600 hover:to-red-500 transition duration-300 w-full cursor-pointer hidden"
      >
        Kalkulator registracije
      </button>
    </div>
  </div>
</header>

<script>
  import '../scripts/header';
</script>

<!-- Registration Calculator Modal -->
<div
  id="calculator-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center"
>
  <!-- Backdrop -->
  <div
    id="calculator-backdrop"
    class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity duration-300"
  >
  </div>

  <!-- Modal content -->
  <div
    class="relative bg-white rounded-2xl shadow-2xl w-full max-w-xl mx-4 max-h-[90vh] overflow-y-auto transform transition-all duration-300 scale-95 opacity-0"
    id="calculator-modal-content"
    data-strapi-url={strapiUrl}
    data-locations={JSON.stringify(locationOptions)}
  >
    <!-- Header -->
    <div
      class="flex items-center justify-between px-6 py-4 border-b border-gray-200"
    >
      <h2 class="text-xl font-bold text-primary">Kalkulator registracije</h2>
      <button
        type="button"
        id="close-calculator-btn"
        class="text-gray-400 hover:text-gray-600 transition p-1 cursor-pointer"
        aria-label="Zatvori"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Form -->
    <form id="calculator-form" class="px-6 py-5 space-y-5 max-w-md mx-auto">
      <!-- Godište -->
      <div>
        <label
          for="calc-year"
          class="block text-sm font-semibold text-gray-700 mb-1">Godište</label
        >
        <select
          id="calc-year"
          name="year"
          required
          class="w-full border border-gray-300 rounded-lg px-4 pr-10 py-2.5 text-gray-700 focus:ring-2 focus:ring-accent focus:border-accent transition appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%236b7280%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M6%209l6%206%206-6%22/%3E%3C/svg%3E')] bg-no-repeat bg-[right_0.75rem_center] bg-[length:1.25rem]"
        >
          <option value="" disabled selected>Izaberi godište</option>
        </select>
      </div>

      <!-- Zapremina ccm -->
      <div>
        <label
          for="calc-ccm"
          class="block text-sm font-semibold text-gray-700 mb-1"
          >Zapremina (ccm)</label
        >
        <input
          type="number"
          id="calc-ccm"
          name="ccm"
          required
          min="0"
          placeholder="npr. 1598"
          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:ring-2 focus:ring-accent focus:border-accent transition"
        />
      </div>

      <!-- Snaga kW -->
      <div>
        <label
          for="calc-kw"
          class="block text-sm font-semibold text-gray-700 mb-1"
          >Snaga (kW)</label
        >
        <input
          type="number"
          id="calc-kw"
          name="kw"
          required
          min="0"
          placeholder="npr. 81"
          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:ring-2 focus:ring-accent focus:border-accent transition"
        />
      </div>

      <!-- Izaberi lokaciju -->
      <div>
        <label
          for="calc-location"
          class="block text-sm font-semibold text-gray-700 mb-1"
          >Izaberi lokaciju</label
        >
        <select
          id="calc-location"
          name="location"
          required
          class="w-full border border-gray-300 rounded-lg px-4 pr-10 py-2.5 text-gray-700 focus:ring-2 focus:ring-accent focus:border-accent transition appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%236b7280%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M6%209l6%206%206-6%22/%3E%3C/svg%3E')] bg-no-repeat bg-[right_0.75rem_center] bg-[length:1.25rem]"
        >
          <option value="" disabled selected>Izaberi lokaciju</option>
        </select>
      </div>

      <!-- Kontakt telefon -->
      <div>
        <label
          for="calc-phone"
          class="block text-sm font-semibold text-gray-700 mb-1"
          >Unesi kontakt telefon</label
        >
        <input
          type="tel"
          id="calc-phone"
          name="phone"
          required
          placeholder="npr. 0611234567"
          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:ring-2 focus:ring-accent focus:border-accent transition"
        />
      </div>

      <!-- Email (opciono) -->
      <div>
        <label
          for="calc-email"
          class="block text-sm font-semibold text-gray-700 mb-1"
          >Unesi email
          <span class="text-gray-400 font-normal">(opciono)</span></label
        >
        <input
          type="email"
          id="calc-email"
          name="email"
          placeholder="npr. ime@primer.rs"
          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:ring-2 focus:ring-accent focus:border-accent transition"
        />
      </div>

      <!-- Submit -->
      <button
        type="submit"
        id="calculator-submit-btn"
        class="w-full bg-gradient-to-r from-accent to-orange-500 hover:from-orange-600 hover:to-red-500 text-white font-bold py-3 rounded-lg transition duration-300 transform hover:scale-[1.02] hover:shadow-lg cursor-pointer"
      >
        Pošalji zahtev
      </button>
    </form>

    <!-- Loading overlay (hidden by default) -->
    <div
      id="calculator-loading"
      class="hidden absolute inset-0 bg-white/80 rounded-2xl z-50 flex flex-col items-center justify-center"
    >
      <svg
        class="animate-spin h-12 w-12 text-accent mb-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <p class="text-gray-600 font-semibold">Slanje zahteva...</p>
    </div>

    <!-- Success message (hidden by default) -->
    <div id="calculator-success" class="hidden px-6 py-10 text-center">
      <div class="text-green-500 mb-4">
        <svg
          class="w-16 h-16 mx-auto"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <p class="text-gray-700 text-lg font-medium">
        Uskoro ćemo vas kontaktirati sa detaljnom kalkulacijom i opcijama za
        plaćanje.
      </p>
      <p
        id="calculator-email-warning"
        class="hidden mt-3 text-amber-600 text-sm"
      >
        Napomena: Email obaveštenje nije uspešno poslato. Vaš zahtev je sačuvan
        i bićete kontaktirani telefonom.
      </p>
    </div>
  </div>
</div>
