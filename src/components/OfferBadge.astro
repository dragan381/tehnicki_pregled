---
export interface Props {
  title?: string;
}

const { title = 'Specijalna\nponuda' } = Astro.props as Props;
const titleOneLine = title.replace(/\n/g, ' ');
---

<!-- Mobile: horizontal rectangle badge -->
<div class="flex-shrink-0 block md:hidden w-full">
  <div
    class="relative flex items-center justify-start"
    style="perspective: 1000px;"
  >
    <div
      class="offer-badge-mobile bg-gradient-to-r from-accent to-orange-600 rounded-md px-3 py-2 shadow-[0_0_12px_rgba(249,115,22,0.4)]"
    >
      <span
        class="text-xs font-black text-white whitespace-nowrap drop-shadow-lg"
      >
        {titleOneLine}
      </span>
    </div>
    <div
      class="offer-circle absolute -top-2 -left-2 bg-white rounded-full w-4 h-4 shadow-lg flex items-center justify-center"
    >
      <div class="w-2 h-2 rounded-full border-2 border-accent"></div>
    </div>
  </div>
</div>

<!-- Tablet + Desktop: rotated square badge -->
<div class="flex-shrink-0 hidden md:block">
  <div
    class="relative w-20 h-20 flex items-center justify-center"
    style="perspective: 1000px;"
  >
    <div
      class="offer-badge absolute inset-0 bg-gradient-to-br from-accent to-orange-600 rounded-lg shadow-[0_0_20px_rgba(249,115,22,0.4)] transform -rotate-12 flex items-center justify-center"
    >
      <div class="text-center">
        <div
          class="text-xs md:text-sm font-black text-white leading-tight whitespace-pre-line drop-shadow-lg"
        >
          {title}
        </div>
      </div>
    </div>
    <div
      class="offer-circle absolute -top-2 -left-2 bg-white rounded-full w-5 h-5 shadow-lg flex items-center justify-center"
    >
      <div class="w-3 h-3 rounded-full border-2 border-accent"></div>
    </div>
  </div>
</div>
