---
import { getPath, formatPhoneHref } from '../utils/navigation';
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import LocationGallery from './LocationGallery.astro';
import { getStrapiImageUrl, getSettings, blocksToText } from '../utils/strapi';
import type { Location } from '../types/strapi';

interface Props {
  location: Location;
}

const { location } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const settings = await getSettings();

const imageUrl = getStrapiImageUrl(location.coverImage);
const descriptionText = blocksToText(location.description);

// Google Maps: API key from env var, with Strapi fallback
// IMPORTANT: Restrict this key in Google Cloud Console → API restrictions → Maps Embed API only
// and HTTP referrer restrictions → your Vercel domain (e.g. *.vercel.app/*, yourdomain.rs/*)
const googleMapsApiKey = import.meta.env.GOOGLE_MAPS_API_KEY || settings?.googleMapsApiKey || '';
const rawMapsLink = location.googleMapsLink || '';

// Ensure the embed URL uses the API key from environment
const googleMapsLink = (() => {
  if (!rawMapsLink) return '';
  try {
    const url = new URL(rawMapsLink);
    if (googleMapsApiKey && !url.searchParams.has('key')) {
      url.searchParams.set('key', googleMapsApiKey);
    }
    return url.toString();
  } catch {
    return rawMapsLink;
  }
})();
---

<Layout
  title={`${location.name} - Prvi Balkan`}
  description={`Lokacija ${location.name} - Prvi Balkan`}
>
  <div class="pt-32 pb-16">
    <div class="max-w-6xl mx-auto px-4">
      <!-- Page header -->
      <div class="mb-10">
        <h1 class="text-4xl md:text-5xl font-bold text-primary">
          {location.name}
        </h1>
        {location.address && (
          <p class="mt-2 text-lg text-gray-500 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            {location.address}
          </p>
        )}
      </div>

      <!-- Gallery section (full width) -->
      <LocationGallery
        image={location.coverImage}
        gallery={location.gallery}
        locationName={location.name}
      />

      <!-- Info cards row -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-10">
        <!-- Contact info card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
          <h2 class="text-xl font-bold text-primary mb-5 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
            </svg>
            Kontakt informacije
          </h2>
          <div class="space-y-4">
            {
              location.phone && (
                <div class="flex items-start gap-3">
                  <span class="text-sm font-semibold text-gray-400 uppercase tracking-wide w-20 flex-shrink-0 pt-0.5">Telefon</span>
                  <a href={`tel:${formatPhoneHref(location.phone)}`} class="text-gray-700 hover:text-accent transition font-medium">
                    {location.phone}
                  </a>
                </div>
              )
            }
            {
              location.email && (
                <div class="flex items-start gap-3">
                  <span class="text-sm font-semibold text-gray-400 uppercase tracking-wide w-20 flex-shrink-0 pt-0.5">Email</span>
                  <a href={`mailto:${location.email}`} class="text-gray-700 hover:text-accent transition font-medium">
                    {location.email}
                  </a>
                </div>
              )
            }
            {
              location.address && (
                <div class="flex items-start gap-3">
                  <span class="text-sm font-semibold text-gray-400 uppercase tracking-wide w-20 flex-shrink-0 pt-0.5">Adresa</span>
                  <span class="text-gray-700">{location.address}</span>
                </div>
              )
            }
          </div>
          <div class="mt-8">
            <a
              href={getPath('/kontakt', baseUrl)}
              class="inline-flex items-center gap-2 bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-xl transition shadow-md shadow-accent/20 hover:shadow-lg hover:shadow-accent/30"
            >
              Zakaži termin
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Opening Hours card -->
        {
          location.openingHours && (
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
              <h2 class="text-xl font-bold text-primary mb-5 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                </svg>
                Radno vreme
              </h2>
              <ul class="space-y-3">
                {Object.entries(location.openingHours).map(([day, hours]) => (
                  <li class="flex justify-between items-center py-1 border-b border-gray-50 last:border-0">
                    <span class="font-medium text-gray-700">{day}</span>
                    <span class="text-gray-600 font-mono text-sm bg-gray-50 px-3 py-1 rounded-lg">{hours}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      <!-- Description Section -->
      {
        descriptionText && (
          <div class="mt-10 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
            <h2 class="text-xl font-bold text-primary mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
              O ovoj lokaciji
            </h2>
            <p class="text-gray-600 leading-relaxed">{descriptionText}</p>
          </div>
        )
      }

      <!-- Google Maps Section -->
      {
        googleMapsLink && (
          <div class="mt-10">
            <h2 class="text-xl font-bold text-primary mb-5 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              Lokacija na mapi
            </h2>
            <div class="rounded-2xl overflow-hidden shadow-sm border border-gray-100 relative" data-map-container>
              <!-- Spinner overlay -->
              <div class="absolute inset-0 flex flex-col items-center justify-center bg-gray-100 z-10" data-map-spinner>
                <svg class="animate-spin h-10 w-10 text-accent mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="text-gray-500 text-sm">Učitavanje mape...</p>
              </div>
              <iframe
                title={`Mapa - ${location.name}`}
                width="100%"
                height="450"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src={googleMapsLink}
                data-map-iframe
              />
            </div>
          </div>
        )
      }
    </div>
  </div>

  <!-- Schema.org Structured Data for this location (dynamic from Strapi) -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      {
        '@context': 'https://schema.org',
        '@type': 'AutoRepair',
        name: `Prvi Balkan - ${location.name}`,
        description:
          descriptionText ||
          `Tehnički pregled vozila - lokacija ${location.name}`,
        address: {
          '@type': 'PostalAddress',
          streetAddress: location.address,
          addressCountry: 'RS',
        },
        telephone: location.phone,
        email: location.email,
        ...(location.openingHours && {
          openingHoursSpecification: Object.entries(location.openingHours).map(
            ([day, hours]) => ({
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: day,
              opens: typeof hours === 'string' ? hours.split('-')[0] : '',
              closes: typeof hours === 'string' ? hours.split('-')[1] : '',
            }),
          ),
        }),
        ...(imageUrl && { image: imageUrl }),
        ...(location.googleMapsLink && { hasMap: location.googleMapsLink }),
        parentOrganization: {
          '@type': 'Organization',
          name: 'Prvi Balkan - Tehnički Pregled',
        },
      },
      null,
      2,
    )}
  />

  <Footer />
</Layout>

<script>
  const iframe = document.querySelector('[data-map-iframe]') as HTMLIFrameElement | null;
  const spinner = document.querySelector('[data-map-spinner]') as HTMLElement | null;
  if (iframe && spinner) {
    iframe.addEventListener('load', () => {
      spinner.style.transition = 'opacity 300ms ease';
      spinner.style.opacity = '0';
      setTimeout(() => spinner.remove(), 300);
    });
  }
</script>
