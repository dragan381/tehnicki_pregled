---
import { getPath } from '../utils/navigation';
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { getStrapiImageUrl, getSettings, blocksToText } from '../utils/strapi';
import { Image } from 'astro:assets';
import type { Location } from '../types/strapi';

interface Props {
  location: Location;
}

const { location } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const settings = await getSettings();

const imageUrl = getStrapiImageUrl(location.image);
const descriptionText = blocksToText(location.description);
const googleMapsApiKey = settings?.googleMapsApiKey || '';
const googleMapsLink = location.googleMapsLink || '';
console.log('Google Maps Link:', googleMapsLink);
---

<Layout
  title={`${location.name} - Prvi Balkan`}
  description={`Lokacija ${location.name} - Prvi Balkan`}
>
  <div class="pt-32 pb-16">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary mb-8">
        Lokacija {location.name}
      </h1>

      <!-- Three column layout -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
        <!-- Column 1: Address info & Zakaži button -->
        <div>
          <h2 class="text-2xl font-bold text-primary mb-6">Informacije</h2>
          <div class="space-y-4">
            {
              location.address && (
                <div>
                  <h3 class="font-bold text-primary mb-2">Adresa</h3>
                  <p class="text-gray-600">{location.address}</p>
                </div>
              )
            }
            {
              location.phone && (
                <div>
                  <h3 class="font-bold text-primary mb-2">Telefon</h3>
                  <p class="text-gray-600">
                    <a href={`tel:${location.phone}`} class="hover:text-accent">
                      {location.phone}
                    </a>
                  </p>
                </div>
              )
            }
            {
              location.email && (
                <div>
                  <h3 class="font-bold text-primary mb-2">Email</h3>
                  <p class="text-gray-600">
                    <a
                      href={`mailto:${location.email}`}
                      class="hover:text-accent"
                    >
                      {location.email}
                    </a>
                  </p>
                </div>
              )
            }
          </div>

          <div class="mt-8">
            <a
              href={getPath('/kontakt', baseUrl)}
              class="inline-block bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition"
            >
              Zakaži
            </a>
          </div>
        </div>

        <!-- Column 2: Opening Hours -->
        <div>
          {
            location.openingHours && (
              <div>
                <h2 class="text-2xl font-bold text-primary mb-6">
                  Radno vreme
                </h2>
                <ul class="text-gray-600 space-y-2">
                  {Object.entries(location.openingHours).map(([day, hours]) => (
                    <li class="flex">
                      <span class="font-medium text-gray-700">{day}</span>
                      <span class="pl-4">{hours}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <!-- Column 3: Image -->
        <div>
          {
            imageUrl && (
              <div class="rounded-lg overflow-hidden shadow-md">
                <Image
                  src={imageUrl}
                  alt={`Lokacija ${location.name}`}
                  width={800}
                  height={500}
                  class="w-full h-auto"
                />
              </div>
            )
          }
        </div>
      </div>

      <!-- Description Section -->
      {
        descriptionText && (
          <div class="mt-12">
            <h2 class="text-2xl font-bold text-primary mb-6">
              O Ovoj Lokaciji
            </h2>
            <p class="text-gray-700 leading-relaxed">{descriptionText}</p>
          </div>
        )
      }

      <!-- Google Maps Section -->
      {
        googleMapsLink && (
          <div class="mt-12">
            <h2 class="text-2xl font-bold text-primary mb-6">
              Lokacija na mapi
            </h2>
            <div class="rounded-lg overflow-hidden shadow-md relative" data-map-container>
              <!-- Spinner overlay -->
              <div class="absolute inset-0 flex flex-col items-center justify-center bg-gray-100 z-10" data-map-spinner>
                <svg class="animate-spin h-10 w-10 text-accent mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="text-gray-500 text-sm">Učitavanje mape...</p>
              </div>
              <iframe
                title={`Mapa - ${location.name}`}
                width="100%"
                height="450"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src={googleMapsLink}
                data-map-iframe
              />
            </div>
          </div>
        )
      }
    </div>
  </div>

  <!-- Schema.org Structured Data for this location (dynamic from Strapi) -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      {
        '@context': 'https://schema.org',
        '@type': 'AutoRepair',
        name: `Prvi Balkan - ${location.name}`,
        description:
          descriptionText ||
          `Tehnički pregled vozila - lokacija ${location.name}`,
        address: {
          '@type': 'PostalAddress',
          streetAddress: location.address,
          addressCountry: 'RS',
        },
        telephone: location.phone,
        email: location.email,
        ...(location.openingHours && {
          openingHoursSpecification: Object.entries(location.openingHours).map(
            ([day, hours]) => ({
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: day,
              opens: typeof hours === 'string' ? hours.split('-')[0] : '',
              closes: typeof hours === 'string' ? hours.split('-')[1] : '',
            }),
          ),
        }),
        ...(imageUrl && { image: imageUrl }),
        ...(location.googleMapsLink && { hasMap: location.googleMapsLink }),
        parentOrganization: {
          '@type': 'Organization',
          name: 'Prvi Balkan - Tehnički Pregled',
        },
      },
      null,
      2,
    )}
  />

  <Footer />
</Layout>

<script>
  const iframe = document.querySelector('[data-map-iframe]') as HTMLIFrameElement | null;
  const spinner = document.querySelector('[data-map-spinner]') as HTMLElement | null;
  if (iframe && spinner) {
    iframe.addEventListener('load', () => {
      spinner.style.transition = 'opacity 300ms ease';
      spinner.style.opacity = '0';
      setTimeout(() => spinner.remove(), 300);
    });
  }
</script>
