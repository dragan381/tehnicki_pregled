---
---

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-primary animate-fadeIn">Naše Lokacije</h2>
    <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto animate-slideUp" style="animation-delay: 0.1s">3 lokacije u Beogradu za vašu pogodnost. Odaberite koja je najbliža vama.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <a href="/lokacije/zemun" class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 transform hover:scale-105 group animate-slideUp" style="animation-delay: 0.2s">
        <div class="relative overflow-hidden">
          <img src="https://images.unsplash.com/photo-1762912297981-ee1a51f4f187?q=80&w=737&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Lokacija Zemun - Tehnički pregled vozila" class="w-full h-48 object-cover group-hover:scale-110 transition duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition duration-300"></div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition">Zemun</h3>
          <p class="text-gray-600 mb-4">Ulica Glavna 123, 11080 Zemun</p>
          <div class="flex items-center text-accent group-hover:translate-x-1 transition duration-300">
            <span class="material-icons text-sm group-hover:rotate-12 transition duration-300">arrow_forward</span>
            <span class="ml-2">Detaljnije</span>
          </div>
        </div>
      </a>

      <a href="/lokacije/ugrinovacka" class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 transform hover:scale-105 group animate-slideUp" style="animation-delay: 0.3s">
        <div class="relative overflow-hidden">
          <img src="https://images.unsplash.com/photo-1746079074522-2b14240d932c?w=500&h=400&fit=crop" alt="Lokacija Ugrinovačka - Dijagnostika vozila" class="w-full h-48 object-cover group-hover:scale-110 transition duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition duration-300"></div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition">Ugrinovačka</h3>
          <p class="text-gray-600 mb-4">Ugrinovačka 456, 11070 Beograd</p>
          <div class="flex items-center text-accent group-hover:translate-x-1 transition duration-300">
            <span class="material-icons text-sm group-hover:rotate-12 transition duration-300">arrow_forward</span>
            <span class="ml-2">Detaljnije</span>
          </div>
        </div>
      </a>

      <a href="/lokacije/vozdovac" class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 transform hover:scale-105 group animate-slideUp" style="animation-delay: 0.4s">
        <div class="relative overflow-hidden">
          <img src="https://images.unsplash.com/photo-1687845542172-977c123c65f6?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Lokacija Voždovac - Servis vozila" class="w-full h-48 object-cover group-hover:scale-110 transition duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition duration-300"></div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition">Voždovac</h3>
          <p class="text-gray-600 mb-4">Voždovska 789, 11050 Beograd</p>
          <div class="flex items-center text-accent group-hover:translate-x-1 transition duration-300">
            <span class="material-icons text-sm group-hover:rotate-12 transition duration-300">arrow_forward</span>
            <span class="ml-2">Detaljnije</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>
