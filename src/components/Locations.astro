---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getPath } from '../utils/navigation';
import { getLocations, getStrapiImageUrl } from '../utils/strapi';

const baseUrl = import.meta.env.BASE_URL;
const locations = await getLocations();
---

<section class="py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-primary animate-fadeIn">Naše Lokacije</h2>
    <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto animate-slideUp" style="animation-delay: 0.1s">3 lokacije u Beogradu za vašu pogodnost. Odaberite koja je najbliža vama.</p>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {locations.map((location, index) => (
        <a href={getPath(`/lokacije/${location.slug}`, baseUrl)} class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-2xl transition duration-300 transform hover:scale-105 group animate-slideUp" style={`animation-delay: ${0.2 + index * 0.1}s`}>
          <div class="relative overflow-hidden">
            {location.image?.url ? (
              <Image 
                src={getStrapiImageUrl(location.image)} 
                alt={location.name} 
                width={400}
                height={192}
                class="w-full h-48 object-cover group-hover:scale-110 transition duration-500"
              />
            ) : (
              <div class="w-full h-48 bg-gray-300 flex items-center justify-center">No image</div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition">{location.name}</h3>
            <p class="text-gray-600 mb-4">{location.address}</p>
            <div class="flex items-center text-accent group-hover:translate-x-1 transition duration-300">
              <Icon name="arrow_forward" size="sm" class="group-hover:rotate-12 transition duration-300" />
              <span class="ml-2">Detaljnije</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
