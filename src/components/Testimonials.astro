---
import Icon from './Icon.astro';
import { getPath } from '../utils/navigation';
import { getTestimonials, blocksToText } from '../utils/strapi';

const baseUrl = import.meta.env.BASE_URL;
const testimonials = await getTestimonials();
const showCarousel = testimonials.length > 3;

// Gradient colors for avatars
const avatarColors = [
  'from-blue-400 to-blue-600',
  'from-orange-400 to-orange-600',
  'from-green-400 to-green-600',
  'from-purple-400 to-purple-600',
];

// Function to get initials from name
function getInitials(name: string): string {
  return name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
}

// Hardcoded fallback testimonials in case Strapi has none
const fallbackTestimonials = [
  { name: 'Marko Jovanović', role: 'Privatni vozač', content: 'Izuzetno brz i profesionalan servis. Sve je bilo gotovo u manje od sat vremena. Preporučujem svima!', rating: 5 },
  { name: 'Nikola Kostić', role: 'Vlasnik kompanije', content: 'Pouzdani ljudi kojima se mogu poveriti sa mojim vozilima. Transparentne cene bez pretnje. Odličan izbor!', rating: 5 },
  { name: 'Ana Petrović', role: 'Penzionisana', content: 'Veoma ljubazna ekipa koja je pažljivo objasnila sve rezultate pregleda. Hvala vam puno!', rating: 5 },
];

const displayTestimonials = testimonials.length > 0
  ? testimonials.map(t => ({
      name: t.author || t.name || 'Anonimno',
      role: t.role || '',
      content: blocksToText(t.content) || '',
      rating: t.rating || 5,
    }))
  : fallbackTestimonials;
---

<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-card-carousel={showCarousel ? 'testimonials' : undefined}>
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-primary animate-fadeIn">Što Kažu Naši Klijenti</h2>
    <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto animate-slideUp" style="animation-delay: 0.1s">Hiljadu zadovoljnih klijenta koji su imali odličan doživljaj sa našim servisom.</p>
    
    {showCarousel ? (
      <div class="relative">
        <!-- Arrows -->
        <button type="button" data-carousel-prev class="hidden md:inline-flex absolute -left-4 lg:-left-8 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-lg items-center justify-center text-primary hover:bg-gray-50 transition cursor-pointer">
          <Icon name="chevron_right" class="rotate-180" />
        </button>
        <button type="button" data-carousel-next class="hidden md:inline-flex absolute -right-4 lg:-right-8 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white shadow-lg items-center justify-center text-primary hover:bg-gray-50 transition cursor-pointer">
          <Icon name="chevron_right" />
        </button>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-carousel-track>
          {displayTestimonials.map((testimonial, index) => (
            <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-2xl transition duration-300 transform hover:scale-105" data-carousel-card>
              <div class="flex items-center mb-4">
                <div class={`w-12 h-12 rounded-full bg-gradient-to-br ${avatarColors[index % avatarColors.length]} flex items-center justify-center text-white font-bold text-lg`}>
                  {getInitials(testimonial.name)}
                </div>
                <div class="ml-4">
                  <h4 class="font-bold text-primary">{testimonial.name}</h4>
                  {testimonial.role && <p class="text-gray-500 text-sm">{testimonial.role}</p>}
                </div>
              </div>
              <div class="flex mb-4">
                {Array.from({ length: testimonial.rating }).map(() => (
                  <Icon name="star" size="sm" class="text-accent" />
                ))}
              </div>
              <p class="text-gray-600">{testimonial.content}</p>
            </div>
          ))}
        </div>

        <!-- Dots -->
        <div class="flex items-center justify-center gap-2 mt-8" data-carousel-dots></div>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {displayTestimonials.map((testimonial, index) => (
          <div class="bg-white p-8 rounded-lg shadow-lg hover:shadow-2xl transition duration-300 transform hover:scale-105 animate-slideUp" style={`animation-delay: ${(index + 2) * 0.1}s`}>
            <div class="flex items-center mb-4">
              <div class={`w-12 h-12 rounded-full bg-gradient-to-br ${avatarColors[index % avatarColors.length]} flex items-center justify-center text-white font-bold text-lg`}>
                {getInitials(testimonial.name)}
              </div>
              <div class="ml-4">
                <h4 class="font-bold text-primary">{testimonial.name}</h4>
                {testimonial.role && <p class="text-gray-500 text-sm">{testimonial.role}</p>}
              </div>
            </div>
            <div class="flex mb-4">
              {Array.from({ length: testimonial.rating }).map(() => (
                <Icon name="star" size="sm" class="text-accent" />
              ))}
            </div>
            <p class="text-gray-600">{testimonial.content}</p>
          </div>
        ))}
      </div>
    )}

    <div class="text-center mt-12">
      <a href={getPath('/kontakt', baseUrl)} class="inline-block bg-gradient-to-r from-accent to-orange-500 hover:from-orange-600 hover:to-red-500 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105">
        <span class="inline-flex items-center gap-2">
          <Icon name="bolt" />
          Zakaži Pregled Danas
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { initCardCarousel } from '../scripts/cardCarousel';
  initCardCarousel('[data-card-carousel="testimonials"]');
</script>
