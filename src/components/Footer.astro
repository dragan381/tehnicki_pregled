<footer class="bg-primary text-white py-12 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 animate-slideUp">
      <div class="group hover:translate-y-1 transition duration-300">
        <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
          <span class="material-icons text-accent group-hover:rotate-12 transition duration-300">directions_car</span>
          <span><span class="text-accent">Prvi</span> Balkan</span>
        </h3>
        <p class="text-blue-100">Tehnički pregled vozila sa 10+ godina iskustva i 3 lokacije u Beogradu.</p>
      </div>
      <div class="group hover:translate-y-1 transition duration-300">
        <h4 class="font-bold mb-4 flex items-center gap-2">
          <span class="material-icons text-accent text-lg">link</span>
          Brzine Veze
        </h4>
        <ul class="space-y-2 text-blue-100">
          <li><a href="/" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            Početna
          </a></li>
          <li><a href="/usluge" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            Usluge
          </a></li>
          <li><a href="/lokacije" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            Lokacije
          </a></li>
          <li><a href="/blog" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            Blog
          </a></li>
        </ul>
      </div>
      <div class="group hover:translate-y-1 transition duration-300">
        <h4 class="font-bold mb-4 flex items-center gap-2">
          <span class="material-icons text-accent text-lg">info</span>
          Informacije
        </h4>
        <ul class="space-y-2 text-blue-100">
          <li><a href="/cesto-pitana-pitanja" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            FAQ
          </a></li>
          <li><a href="/o-nama" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            O Nama
          </a></li>
          <li><a href="/privatnost" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            Privatnost
          </a></li>
          <li><a href="/uslovi" class="hover:text-white transition inline-flex items-center gap-2 group">
            <span class="material-icons text-sm opacity-0 group-hover:opacity-100 transition">arrow_forward</span>
            Uslovi
          </a></li>
        </ul>
      </div>
      <div class="group hover:translate-y-1 transition duration-300">
        <h4 class="font-bold mb-4 flex items-center gap-2">
          <span class="material-icons text-accent text-lg">phone</span>
          Kontakt
        </h4>
        <ul class="space-y-2 text-blue-100">
          <li class="flex items-center gap-2">
            <span class="material-icons text-sm text-accent">phone</span>
            Tel: +381 11 2101 111
          </li>
          <li class="flex items-center gap-2">
            <span class="material-icons text-sm text-accent">mail</span>
            Email: info@prvi-balkan.rs
          </li>
          <li class="flex items-center gap-2">
            <span class="material-icons text-sm text-accent">schedule</span>
            Radno vreme: 08:00-18:00 (ponedjeljak-petak)
          </li>
          <li class="flex items-center gap-2">
            <span class="material-icons text-sm text-accent">schedule</span>
            09:00-15:00 (subota)
          </li>
        </ul>
      </div>
    </div>
    <div class="border-t border-blue-400 pt-8 animate-slideUp" style="animation-delay: 0.2s">
      <p class="text-center text-blue-100">&copy; 2025 Prvi Balkan. Sva prava zadržana.</p>
    </div>
