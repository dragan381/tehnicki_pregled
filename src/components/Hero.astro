---
import { Image } from 'astro:assets';
import { getPath } from '../utils/navigation';
const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
  backgroundImage?: string;
}

const { title, description, buttonText, buttonLink, backgroundImage } = Astro.props as Props;
---

<section class="relative h-96 overflow-hidden">
  {backgroundImage && (
    <Image 
      src={backgroundImage} 
      alt={title}
      width={1200}
      height={600}
      class="absolute inset-0 w-full h-full object-cover"
    />
  )}
  <div class="absolute inset-0 bg-black bg-opacity-50"></div>
  <div class="relative h-full flex items-center justify-center text-center px-4">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 animate-slideUp">{title}</h1>
      <p class="text-lg md:text-xl text-gray-100 mb-8 animate-slideUp" style="animation-delay: 0.2s">{description}</p>
      <a href={getPath(buttonLink, baseUrl)} class="inline-block bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105 animate-slideUp" style="animation-delay: 0.4s">
        {buttonText}
      </a>
    </div>
  </div>
</section>
