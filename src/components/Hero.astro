---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import HeroSlideText from './HeroSlideText.astro';
import HeroSlideImage from './HeroSlideImage.astro';
import { getPath } from '../utils/navigation';
import { getLocations, getStrapiImageUrl } from '../utils/strapi';
import '../styles/hero.css';
const baseUrl = import.meta.env.BASE_URL;

export interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonLink: string;
  backgroundImage?: string;
}

const { title, description, buttonText, buttonLink, backgroundImage } = Astro.props as Props;
const orderedLocations = await getLocations(); // Already sorted by order:asc from Strapi
const hasLocations = orderedLocations.length > 0;
---

<section class="relative overflow-hidden">
  {backgroundImage && (
    <Image
      src={backgroundImage}
      alt={title}
      width={1200}
      height={600}
      class="absolute inset-0 w-full h-full object-cover blur-[2px] scale-105"
    />
  )}
  <div class="absolute inset-0 bg-black/40"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-primary/75 via-primary/40 to-transparent"></div>
  <div class="absolute -right-24 -top-16 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div>
  <div class="absolute left-8 bottom-10 h-40 w-40 rounded-full bg-accent/20 blur-3xl"></div>
  <!-- Bottom fade into SpecialOffer section -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-b from-transparent to-slate-900/90 z-10"></div>

  {hasLocations ? (
    <div class="relative" data-hero-carousel>

      <!-- Left arrow - hidden on mobile/tablet, visible on lg+ -->
      <button
        type="button"
        class="hero-control hero-control-side hidden lg:inline-flex"
        style="left: 0.5rem; top: 50%; transform: translateY(-50%);"
        aria-label="Previous location"
        data-hero-prev
      >
        <Icon name="chevron_right" class="rotate-180" />
      </button>

      <!-- Right arrow - hidden on mobile/tablet, visible on lg+ -->
      <button
        type="button"
        class="hero-control hero-control-side hidden lg:inline-flex"
        style="right: 0.5rem; top: 50%; transform: translateY(-50%);"
        aria-label="Next location"
        data-hero-next
      >
        <Icon name="chevron_right" />
      </button>

      <!-- Top bar: site title + counter -->
      <div class="px-4 lg:px-24 pt-6 pb-0">
        <div class="flex items-center justify-between text-accent/70 text-xs tracking-[0.3em] uppercase mb-1 font-bold">
          <span>{title}</span>
          {/* <span class="font-semibold text-white" data-hero-count>01 / {String(orderedLocations.length).padStart(2, '0')}</span> */}
        </div>
        <p class="text-white/65 text-sm max-w-lg mb-3">{description}</p>
      </div>

      <!-- Slides -->
      <div class="hero-slides-container relative h-auto md:h-[18rem] lg:h-[22rem] mx-2 md:mx-4 lg:mx-16 overflow-hidden" data-hero-slides-container>
        {orderedLocations.map((location, index) => (
          <div
            class={`hero-slide grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-3 lg:gap-6 items-center px-2 md:px-3 lg:px-10 ${index === 0 ? 'is-active' : ''}`}
            data-hero-slide
            data-index={index}
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <!-- Image: shown first on mobile (order-1), second on tablet/desktop (md:order-2) -->
            <div class="order-1 md:order-2">
              <HeroSlideImage
                name={location.name}
                image={location.image}
              />
            </div>
            <!-- Text content: shown second on mobile (order-2), first on tablet/desktop (md:order-1) -->
            <div class="order-2 md:order-1 relative z-10">
              <HeroSlideText
                order={location.order ?? index + 1}
                name={location.name}
                address={location.address}
                slug={location.slug}
                phone={location.phone}                
              />
            </div>
          </div>
        ))}
      </div>

      <!-- Dots -->
      <div class="px-4 lg:px-20 pt-4 pb-6 flex items-center justify-center lg:justify-end gap-2">
          {orderedLocations.map((_, index) => (
            <button
              type="button"
              class={`hero-dot ${index === 0 ? 'is-active' : ''}`}
              aria-label={`Go to slide ${index + 1}`}
              aria-current={index === 0 ? 'true' : 'false'}
              data-hero-dot
              data-index={index}
            ></button>
          ))}
      </div>

    </div>
  ) : (
    <div class="relative flex items-center justify-center text-center px-4 py-16">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 animate-slideUp">{title}</h1>
        <p class="text-lg md:text-xl text-gray-100 mb-8 animate-slideUp" style="animation-delay: 0.2s">{description}</p>
        <a href={getPath(buttonLink, baseUrl)} class="inline-block bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105 animate-slideUp" style="animation-delay: 0.4s">
          {buttonText}
        </a>
      </div>
    </div>
  )}
</section>

<script>
  import '../scripts/heroCarousel.ts';
</script>
