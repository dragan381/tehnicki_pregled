---
import Icon from './Icon.astro';
import { getSettings } from '../utils/strapi';

interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;

const settings = await getSettings();

const paymentOptions = settings?.paymentOptions?.length
  ? settings.paymentOptions
  : [
      { title: 'Gotovina', icon: 'payment_cash' },
      { title: 'Kartica', icon: 'payment_card' },
      { title: 'A. zabrana', icon: 'payment_ban' },
      { title: 'Čekovi', icon: 'payment_check' },
      { title: 'Na rate', icon: 'payment_installments' },
    ];
---

{
  variant === 'full' ? (
    <section class="py-8 md:py-10 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl md:text-2xl font-bold text-center mb-1 text-primary">
          Načini plaćanja
        </h2>
        <p class="text-gray-500 text-center mb-6 text-sm">
          Izaberite način plaćanja koji vam najviše odgovara
        </p>
        <div class="flex justify-center gap-2 sm:gap-3 md:gap-4">
          {paymentOptions.map((option) => (
            <div class="flex flex-col items-center gap-1 sm:gap-1.5 bg-white rounded-lg p-2 sm:p-3 md:p-4 shadow-sm border border-gray-100 hover:shadow-md hover:border-primary/20 transition flex-1 min-w-0">
              <Icon
                name={option.icon}
                class="w-6 h-6 sm:w-7 sm:h-7 md:w-8 md:h-8 text-primary"
              />
              <span class="text-[9px] sm:text-xs md:text-sm font-medium text-gray-700 text-center leading-tight">
                {option.title}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <div class="flex flex-wrap items-center justify-center gap-4 text-blue-200 text-sm">
      <span class="font-medium text-white">Načini plaćanja:</span>
      {paymentOptions.map((option) => (
        <span class="inline-flex items-center gap-1">
          <Icon name={option.icon} class="w-4 h-4" />
          {option.title}
        </span>
      ))}
    </div>
  )
}
