---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SpecialOffer from '../components/SpecialOffer.astro';
import Services from '../components/Services.astro';
import Locations from '../components/Locations.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import { getSettings, getStrapiImageUrl } from '../utils/strapi';
import Icon from '../components/Icon.astro';

// Fetch settings from Strapi
const settings = await getSettings();

// Use settings for page title and description
const title = settings?.siteName;
const description =
  settings?.siteDescription ||
  'Profesionalni tehnički pregled vozila sa 3 lokacije u Beogradu. Brz i pouzdan servis, registracija vozila i pomoć kod osiguranja.';

// Extract hero settings with fallbacks
const heroTitle =
  settings?.hero?.title || 'Prvi Balkan - Tehnički Pregled Vozila';
const heroDescription =
  settings?.hero?.description ||
  'Profesionalni tehnički pregled sa 10+ godina iskustva. 3 lokacije u Beogradu za vašu pogodnost.';
const heroButtonText = settings?.hero?.buttonText || 'Zakaži Pregled';
const heroButtonLink = settings?.hero?.buttonLink || '/kontakt';
const heroBackgroundImage = settings?.hero?.image
  ? getStrapiImageUrl(settings.hero.image)
  : 'https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=1200&h=600&fit=crop';
const showSpecialOfferSection = settings?.showSpecialOfferSection ?? false;
const showLocationSection = settings?.showLocationSection ?? false;
---

<Layout {title} {description}>
  <Hero
    title={heroTitle}
    description={heroDescription}
    buttonText={heroButtonText}
    buttonLink={heroButtonLink}
    backgroundImage={heroBackgroundImage}
  />
  {
    showSpecialOfferSection && (
      <SpecialOffer
        badgeTitle={settings?.specialOffer?.badgeTitle || 'Specijalna\nponuda'}
        title={settings?.specialOffer?.title || 'PLATI SAMO JEDNOM'}
        description={
          settings?.specialOffer?.description ||
          'Ukoliko vaš automobili nije u potpunosti ispravan, svaki ponovni tehnički pregled je potpuno BESPLATAN dok svi neophodni parametri za uspešan tehnički pregled ne budu na zadovoljavajučem nivou.'
        }
        buttonText={settings?.specialOffer?.buttonText || 'Saznaj više'}
        buttonLink={settings?.specialOffer?.buttonLink || '/usluge'}
        showButton={settings?.specialOffer?.showButton ?? false}
      />
    )
  }

  <WhyChooseUs />

  <Services />
  {showLocationSection && <Locations />}
  <Testimonials />
  <FAQ limit={4} />

  <section class="py-16 bg-primary text-white">
    <div class="max-w-4xl mx-auto text-center px-4">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
        Spreman za Tehnički Pregled?
      </h2>
      <p class="text-lg mb-8 text-blue-100">
        Zakaži danas i prođi tehnički sa sigurnošću. Slobodno nas kontaktiraj na
        bilo kojoj lokaciji.
      </p>
      <div class="flex justify-center">
        <a
          href="/kontakt"
          class="bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition inline-flex items-center gap-2"
        >
          <Icon name="phone" size="sm" />
          Pozovi nas i zakaži
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
