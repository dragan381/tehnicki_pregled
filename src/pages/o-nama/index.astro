---
import { getPath } from '../../utils/navigation';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../components/Footer.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="O Nama - Prvi Balkan" description="Saznaj više o Prvi Balkan - Tehnički pregled vozila">
  
  <div class="pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary mb-8">O Nama</h1>
      
      <p class="text-lg text-gray-700 mb-6">
        Prvi Balkan je vodeća firma za tehnički pregled vozila sa više od 10 godina iskustva na tržištu. Naš tim se bavi pružanjem najkvalitetnije usluge tehnijkog pregleda vozila sa 3 lokacije u Beogradu.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-12">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-8 rounded-lg">
          <h3 class="text-2xl font-bold text-primary mb-4"><Icon name="flash_on" class="align-middle mr-2" />Brzina</h3>
          <p class="text-gray-700">
            Razumemo da je vaš sat dragocen. Trudimo se da sve procese obavimo brzo bez žrtvovanja kvaliteta.
          </p>
        </div>
        <div class="bg-gradient-to-br from-orange-50 to-orange-100 p-8 rounded-lg">
          <h3 class="text-2xl font-bold text-accent mb-4"><Icon name="verified" class="align-middle mr-2" />Pouzdanost</h3>
          <p class="text-gray-700">
            Svaki dan radimo sa posvećenjem da zadovoljimo naše klijente i da im pružimo najbolje usluge.
          </p>
        </div>
      </div>

      <h2 class="text-3xl font-bold text-primary mb-6">Naše Vrednosti</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-8 rounded-lg">
          <h3 class="text-2xl font-bold text-primary mb-4">🎯 Kvalitet</h3>
          <p class="text-gray-700">
            Svaki pregled je obavljen sa najvišim standardima. Ne pravimo kompromise kada je u pitanju tačnost i posvećenost.
          </p>
        </div>
        <div class="bg-gradient-to-br from-orange-50 to-orange-100 p-8 rounded-lg">
          <h3 class="text-2xl font-bold text-accent mb-4">⚡ Brzina</h3>
          <p class="text-gray-700">
            Razumemo da je vaš sat dragocen. Trudimo se da sve procese obavimo brzo bez žrtvovanja kvaliteta.
          </p>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-green-100 p-8 rounded-lg">
          <h3 class="text-2xl font-bold text-green-600 mb-4">🤝 Poverenje</h3>
          <p class="text-gray-700">
            Transparencija i iskrenost su osnova našeg poslovanja. Uvek ćete znati gde stojite i šta se očekuje.
          </p>
        </div>
      </div>

      <h2 class="text-3xl font-bold text-primary mb-6">Tim</h2>
      <p class="text-gray-700 mb-6">
        Naš tim čine iskusni i sertifikovani tehničari sa godinama iskustva u branši. Sve naše radnike je obučava proizvodc-specifična znanja i redovno se usavršavaju.
      </p>
    </div>
  </div>

  <Footer />
</Layout>
