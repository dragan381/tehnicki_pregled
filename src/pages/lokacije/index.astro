---
import { getPath } from '../../utils/navigation';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Locations from '../../components/Locations.astro';
import Footer from '../../components/Footer.astro';
import { getLocations } from '../../utils/strapi';

const baseUrl = import.meta.env.BASE_URL;
const locations = await getLocations();
---

<Layout title="Naše Lokacije - Tehnički Pregled Vozila u Beogradu" description="3 lokacije prvog Balkana za tehnički pregled vozila u Zemunu, Ugrinovoj Čuki i Voždovcu. Brz i pouzdan servis.">
  
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-gradient-to-b from-blue-50 to-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12 animate-fadeIn">
        <h1 class="text-5xl font-bold text-primary mb-4">Naše Lokacije u Beogradu</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-6 animate-slideUp" style="animation-delay: 0.1s">
          Prvi Balkan ima <strong>3 moderne lokacije</strong> raspoređene po Beogradu kako bi Vam pružio najbolju dostupnost i uslugu. Odaberite lokaciju koja je Vam najbliža i zakazite pregled vozila.
        </p>
        <div class="flex justify-center gap-4 flex-wrap animate-slideUp" style="animation-delay: 0.2s">
          <div class="flex items-center gap-2 text-gray-700">
            <Icon name="check_circle" class="text-accent" size="sm" />
            <span>Moderni alati</span>
          </div>
          <div class="flex items-center gap-2 text-gray-700">
            <Icon name="schedule" class="text-accent" size="sm" />
            <span>Fleksibilno radno vreme</span>
          </div>
          <div class="flex items-center gap-2 text-gray-700">
            <Icon name="verified_user" class="text-accent" size="sm" />
            <span>Sertifikovani stručnjaci</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Locations Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-4 text-primary animate-fadeIn">Izaberite Lokaciju</h2>
      <p class="text-center text-gray-600 mb-12 animate-slideUp" style="animation-delay: 0.1s">
        Sva tri centra su opremljena sa najmodernijom dijagnostičkom opremom
      </p>
      <Locations />
    </div>
  </section>

  <!-- Why Multiple Locations Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12 text-primary animate-fadeIn">Zašto Ima Više Lokacija?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition duration-300 animate-slideUp">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 mb-4">
            <Icon name="near_me" class="text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Bliža Vama</h3>
          <p class="text-gray-600">Ne morate da vozite dugo - jedan od naših centara je sigurno u Vašoj blizini u Beogradu. Uštedite vreme i gorivo.</p>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition duration-300 animate-slideUp" style="animation-delay: 0.1s">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-orange-100 mb-4">
            <Icon name="schedule" class="text-accent" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Fleksibilne Opcije</h3>
          <p class="text-gray-600">Različito radno vreme po lokacijama znači da možete pronaći vreme koje vam odgovara. Zakazujete kada je vama najbolje.</p>
        </div>
        
        <div class="bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition duration-300 animate-slideUp" style="animation-delay: 0.2s">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100 mb-4">
            <Icon name="support_agent" class="text-green-600" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Localni Eksperti</h3>
          <p class="text-gray-600">Svaka lokacija ima svoje iskusne timove koji poznaju specifike vozila i potrebe lokalne populacije.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12 text-primary animate-fadeIn">Poređenje Lokacija</h2>
      <div class="overflow-x-auto animate-slideUp" style="animation-delay: 0.1s">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-primary text-white">
              <th class="px-6 py-3 text-left font-bold">Lokacija</th>
              <th class="px-6 py-3 text-center font-bold">Radno vreme</th>
              <th class="px-6 py-3 text-center font-bold">Usluge</th>
              <th class="px-6 py-3 text-center font-bold">Parking</th>
              <th class="px-6 py-3 text-center font-bold">Akcija</th>
            </tr>
          </thead>
          <tbody>
            {locations.map((location) => {
              const hours = location.openingHours?.weekdays || '08:00-18:00';
              return (
                <tr class="border-b hover:bg-blue-50 transition">
                  <td class="px-6 py-4 font-bold text-primary">{location.name}</td>
                  <td class="px-6 py-4 text-center">{hours}</td>
                  <td class="px-6 py-4 text-center"><Icon name="check_circle" class="text-accent" size="sm" /></td>
                  <td class="px-6 py-4 text-center"><Icon name="check_circle" class="text-accent" size="sm" /></td>
                  <td class="px-6 py-4 text-center"><a href={getPath(`/lokacije/${location.slug}`, baseUrl)} class="text-accent font-bold hover:text-orange-600">Detaljnije →</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-4xl mx-auto px-4 text-center animate-slideUp" style="animation-delay: 0.1s">
      <h2 class="text-3xl font-bold mb-4">Spreman/Spremna da Zakazišš Pregled?</h2>
      <p class="text-lg mb-8 text-blue-100">Izaberite lokaciju koja vam odgovara i zakazite pregled vozila odmah</p>
      <a href={getPath('/kontakt', baseUrl)} class="inline-block bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105">
        Zakaži Pregled Sada
      </a>
    </div>
  </section>

  <!-- Schema.org Structured Data for Local Business -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Prvi Balkan - Tehnički Pregled",
    "description": "Tehnički pregled vozila sa 3 lokacije u Beogradu",
    "url": "https://dragan381.github.io/tehnicki_pregled",
    "telephone": "+381112101111",
    "email": "info@prvi-balkan.rs",
    "image": "https://dragan381.github.io/tehnicki_pregled/og-image.jpg",
    "sameAs": [
      "https://facebook.com/prvi-balkan",
      "https://instagram.com/prvi-balkan"
    ],
    "areaServed": "Beograd",
    "priceRange": "2500-5000 RSD",
    "hasMap": "https://maps.google.com/?cid=123456",
    "location": [
      {
        "@type": "Place",
        "name": "Prvi Balkan - Zemun",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Ulica Glavna 123",
          "addressLocality": "Zemun",
          "postalCode": "11080",
          "addressCountry": "RS"
        },
        "telephone": "+381112101111"
      },
      {
        "@type": "Place",
        "name": "Prvi Balkan - Ugrinova Čuka",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Ugrinovačka 456",
          "addressLocality": "Beograd",
          "postalCode": "11070",
          "addressCountry": "RS"
        },
        "telephone": "+381112101111"
      },
      {
        "@type": "Place",
        "name": "Prvi Balkan - Voždovac",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Voždovska 789",
          "addressLocality": "Beograd",
          "postalCode": "11050",
          "addressCountry": "RS"
        },
        "telephone": "+381112101111"
      }
    ]
  }
  </script>

  <Footer />
</Layout>
