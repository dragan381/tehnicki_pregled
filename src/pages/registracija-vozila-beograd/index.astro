---
import { getPath } from '../../utils/navigation';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../components/Footer.astro';
import { getLocations, getServices, getServiceBySlug, blocksToText, getStrapiImageUrl } from '../../utils/strapi';

const baseUrl = import.meta.env.BASE_URL;
const locations = await getLocations();
const services = await getServices();

// Try to get the specific "registracija" service from Strapi
const currentService = await getServiceBySlug('registracija-vozila');
const serviceTitle = currentService?.title || 'Registracija Vozila';
const serviceDescription = currentService ? blocksToText(currentService.description) : '';
const serviceFeatures = currentService?.features?.features || [];
const servicePrice = currentService?.price;

const siteUrl = 'https://prvibalkan.rs';
const pageUrl = `${siteUrl}/registracija-vozila-beograd`;
---

<Layout
  title="Registracija Vozila Beograd - Prvi Balkan | 3 Lokacije"
  description="Registracija vozila u Beogradu na 3 lokacije - Zemun, Voždovac, Ugrinovačka. Prva registracija, produženje, prenos vlasništva. Sve na jednom mestu!"
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-gradient-to-b from-blue-50 to-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12 animate-fadeIn">
        <h1 class="text-4xl md:text-5xl font-bold text-primary mb-4">
          Registracija Vozila u Beogradu
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-6 animate-slideUp" style="animation-delay: 0.1s">
          Kompletna usluga registracije vozila na jednom mestu — <strong>tehnički pregled, osiguranje i registracione nalepnice</strong>
          bez nepotrebnog čekanja, na <strong>3 lokacije u Beogradu</strong>.
        </p>
        <div class="flex justify-center gap-4 flex-wrap animate-slideUp" style="animation-delay: 0.2s">
          <div class="flex items-center gap-2 text-gray-700">
            <Icon name="check_circle" class="text-accent" size="sm" />
            <span>Sve na jednom mestu</span>
          </div>
          <div class="flex items-center gap-2 text-gray-700">
            <Icon name="schedule" class="text-accent" size="sm" />
            <span>Brza procedura</span>
          </div>
          <div class="flex items-center gap-2 text-gray-700">
            <Icon name="verified_user" class="text-accent" size="sm" />
            <span>Ovlašćena stanica</span>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="flex justify-center gap-4 flex-wrap animate-slideUp" style="animation-delay: 0.3s">
        <a href="#lokacije" class="inline-block bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105">
          Pronađi najbližu lokaciju
        </a>
        <a href={getPath('/kontakt', baseUrl)} class="inline-block border-2 border-primary text-primary hover:bg-primary hover:text-white font-bold py-3 px-8 rounded-lg transition">
          Zakaži termin
        </a>
      </div>
    </div>
  </section>

  <!-- What is Registration Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary mb-6 animate-fadeIn">
        Registracija vozila — sve na jednom mestu
      </h2>
      <div class="prose prose-lg text-gray-700 animate-slideUp" style="animation-delay: 0.1s">
        <p>
          Registracija vozila podrazumeva kompletnu proceduru koja uključuje <strong>tehnički pregled</strong>,
          <strong>osiguranje od auto-odgovornosti</strong>, <strong>plaćanje taksi</strong> i <strong>izdavanje registracionih nalepnica</strong>.
          Kod nas u <strong>Prvom Balkanu</strong> sve ovo možete obaviti na jednoj lokaciji, bez potrebe da idete na više mesta.
        </p>
        {serviceDescription && (
          <p>{serviceDescription}</p>
        )}
        <p>
          Bilo da vam je potrebna <strong>prva registracija</strong>, <strong>produženje registracije</strong> ili
          <strong>prenos vlasništva</strong>, naš tim će vam pomoći da ceo proces prođe brzo i bez komplikacija.
        </p>
      </div>
    </div>
  </section>

  <!-- Types of Registration -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-primary mb-12 animate-fadeIn">
        Tipovi registracije koje nudimo
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition duration-300 animate-slideUp">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 mb-4">
            <Icon name="directions_car" class="text-primary" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Prva registracija</h3>
          <p class="text-gray-600 mb-4">Za nova ili uvezena vozila koja se prvi put registruju u Srbiji. Uključuje sve potrebne provere i dokumentaciju.</p>
          <ul class="text-sm text-gray-500 space-y-1">
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Carinska dokumentacija</li>
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Račun o kupovini</li>
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Potvrda o homologaciji</li>
          </ul>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition duration-300 animate-slideUp" style="animation-delay: 0.1s">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-orange-100 mb-4">
            <Icon name="autorenew" class="text-accent" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Produženje registracije</h3>
          <p class="text-gray-600 mb-4">Godišnje produženje registracije za već registrovana vozila. Najčešća usluga — obavite sve za sat vremena.</p>
          <ul class="text-sm text-gray-500 space-y-1">
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Saobraćajna dozvola</li>
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Lična karta</li>
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Prethodna polisa osiguranja</li>
          </ul>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md hover:shadow-lg transition duration-300 animate-slideUp" style="animation-delay: 0.2s">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-100 mb-4">
            <Icon name="swap_horiz" class="text-green-600" />
          </div>
          <h3 class="text-xl font-bold text-primary mb-3">Prenos vlasništva</h3>
          <p class="text-gray-600 mb-4">Preregistracija vozila pri kupoprodaji. Pomažemo sa kompletnom dokumentacijom za novog vlasnika.</p>
          <ul class="text-sm text-gray-500 space-y-1">
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Ugovor o kupoprodaji</li>
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Dokumenta oba vlasnika</li>
            <li class="flex items-center gap-2"><Icon name="check_circle" class="text-accent" size="sm" />Potvrda o plaćenom porezu</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Documents Needed -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary mb-8 animate-fadeIn">
        Koja dokumenta su vam potrebna?
      </h2>
      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-8 animate-slideUp" style="animation-delay: 0.1s">
        <p class="text-gray-700 mb-6">Za produženje registracije (najčešće), potrebno vam je:</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="flex items-center gap-3 p-3 bg-white rounded-lg">
            <Icon name="description" class="text-primary flex-shrink-0" />
            <span class="text-gray-700">Saobraćajna dozvola (original)</span>
          </div>
          <div class="flex items-center gap-3 p-3 bg-white rounded-lg">
            <Icon name="verified_user" class="text-primary flex-shrink-0" />
            <span class="text-gray-700">Lična karta vlasnika</span>
          </div>
          <div class="flex items-center gap-3 p-3 bg-white rounded-lg">
            <Icon name="security" class="text-primary flex-shrink-0" />
            <span class="text-gray-700">Prethodna polisa osiguranja</span>
          </div>
          <div class="flex items-center gap-3 p-3 bg-white rounded-lg">
            <Icon name="attach_money" class="text-primary flex-shrink-0" />
            <span class="text-gray-700">Novac za takse i osiguranje</span>
          </div>
        </div>
        <p class="text-sm text-gray-500 mt-4">* Za prvu registraciju i prenos vlasništva potrebna su dodatna dokumenta. Kontaktirajte nas za detalje.</p>
      </div>
    </div>
  </section>

  <!-- Service Features from Strapi -->
  {serviceFeatures.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-primary mb-8 animate-fadeIn">
          Šta uključuje naša usluga?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {serviceFeatures.map((feature: string, index: number) => (
            <div class="flex items-center gap-3 p-4 bg-white rounded-lg shadow-sm animate-slideUp" style={`animation-delay: ${index * 0.05}s`}>
              <Icon name="check_circle" class="text-accent flex-shrink-0" />
              <span class="text-gray-700 font-medium">{feature}</span>
            </div>
          ))}
        </div>
        {servicePrice && (
          <div class="mt-8 text-center">
            <p class="text-2xl font-bold text-primary">
              Cena: <span class="text-accent">{servicePrice} RSD</span>
            </p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Locations Section -->
  <section id="lokacije" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-primary mb-4 animate-fadeIn">
        Gde možete registrovati vozilo u Beogradu?
      </h2>
      <p class="text-center text-gray-600 mb-12 animate-slideUp" style="animation-delay: 0.1s">
        Na svim našim lokacijama možete obaviti tehnički pregled i registraciju na jednom mestu.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {locations.map((location, index) => (
          <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition duration-300 overflow-hidden animate-slideUp" style={`animation-delay: ${index * 0.1}s`}>
            <!-- Location header -->
            <div class="bg-primary text-white p-6">
              <h3 class="text-xl font-bold mb-1">{location.name}</h3>
              <p class="text-blue-200 text-sm flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
                {location.address}
              </p>
            </div>

            <!-- Location details -->
            <div class="p-6 space-y-4">
              {location.phone && (
                <div class="flex items-center gap-3">
                  <Icon name="phone" class="text-accent flex-shrink-0" size="sm" />
                  <a href={`tel:${location.phone.replace(/[\s\-\(\)]/g, '')}`} class="text-gray-700 hover:text-accent transition">
                    {location.phone}
                  </a>
                </div>
              )}
              {location.email && (
                <div class="flex items-center gap-3">
                  <Icon name="mail" class="text-accent flex-shrink-0" size="sm" />
                  <a href={`mailto:${location.email}`} class="text-gray-700 hover:text-accent transition text-sm">
                    {location.email}
                  </a>
                </div>
              )}
              {location.openingHours && (
                <div class="border-t pt-4 mt-4">
                  <p class="text-sm font-semibold text-gray-500 mb-2 flex items-center gap-1">
                    <Icon name="schedule" class="text-accent" size="sm" />
                    Radno vreme
                  </p>
                  <ul class="space-y-1 text-sm">
                    {Object.entries(location.openingHours).map(([day, hours]) => (
                      <li class="flex justify-between">
                        <span class="text-gray-600">{day}</span>
                        <span class="font-mono text-gray-700">{hours}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <a
                href={getPath(`/lokacije/${location.slug}`, baseUrl)}
                class="block text-center bg-accent hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg transition mt-4"
              >
                Detaljnije o lokaciji →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-primary mb-12 animate-fadeIn">
        Kako izgleda proces registracije?
      </h2>
      <div class="space-y-8">
        <div class="flex gap-6 animate-slideUp">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">1</div>
          <div>
            <h3 class="text-xl font-bold text-primary mb-2">Tehnički pregled</h3>
            <p class="text-gray-600">Prvo se obavlja tehnički pregled vozila na savremenoj opremi. Ceo postupak traje oko 20-30 minuta.</p>
          </div>
        </div>

        <div class="flex gap-6 animate-slideUp" style="animation-delay: 0.1s">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">2</div>
          <div>
            <h3 class="text-xl font-bold text-primary mb-2">Osiguranje</h3>
            <p class="text-gray-600">Na istoj lokaciji zaključujete polisu obaveznog osiguranja od auto-odgovornosti. Nudimo više osiguravajućih kuća za najbolju cenu.</p>
          </div>
        </div>

        <div class="flex gap-6 animate-slideUp" style="animation-delay: 0.2s">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center font-bold text-lg">3</div>
          <div>
            <h3 class="text-xl font-bold text-primary mb-2">Plaćanje taksi</h3>
            <p class="text-gray-600">Uplaćuju se sve potrebne takse — republička administrativna taksa, naknada za korišćenje puteva i ekološka taksa.</p>
          </div>
        </div>

        <div class="flex gap-6 animate-slideUp" style="animation-delay: 0.3s">
          <div class="flex-shrink-0 w-12 h-12 rounded-full bg-accent text-white flex items-center justify-center font-bold text-lg">4</div>
          <div>
            <h3 class="text-xl font-bold text-primary mb-2">Registraciona nalepnica</h3>
            <p class="text-gray-600">Dobijate novu registracionu nalepnicu i potvrdu. Vaše vozilo je registrovano i spremno za drum!</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-primary mb-12 animate-fadeIn">
        Česta pitanja o registraciji vozila
      </h2>
      <div class="space-y-4">
        <details class="bg-white rounded-lg shadow-md hover:shadow-lg transition duration-300 p-6 group cursor-pointer border" open>
          <summary class="flex items-center justify-between font-bold text-primary">
            <span class="flex items-center gap-3">
              <Icon name="help" size="lg" />
              Koliko košta registracija vozila?
            </span>
            <Icon name="expand_more" class="transition duration-300 group-open:rotate-180" />
          </summary>
          <p class="text-gray-600 mt-4 ml-10">Ukupna cena registracije zavisi od kubikaže motora, starosti vozila i izabrane osiguravajuće kuće. Orijentaciono, za prosečan automobil iznosi od 15.000 do 40.000 RSD uključujući tehnički pregled, osiguranje i takse.</p>
        </details>

        <details class="bg-white rounded-lg shadow-md hover:shadow-lg transition duration-300 p-6 group cursor-pointer border">
          <summary class="flex items-center justify-between font-bold text-primary">
            <span class="flex items-center gap-3">
              <Icon name="help" size="lg" />
              Koliko traje ceo proces registracije?
            </span>
            <Icon name="expand_more" class="transition duration-300 group-open:rotate-180" />
          </summary>
          <p class="text-gray-600 mt-4 ml-10">Kompletna registracija (tehnički pregled + osiguranje + takse + nalepnica) obično traje 45 minuta do sat vremena, u zavisnosti od gužve.</p>
        </details>

        <details class="bg-white rounded-lg shadow-md hover:shadow-lg transition duration-300 p-6 group cursor-pointer border">
          <summary class="flex items-center justify-between font-bold text-primary">
            <span class="flex items-center gap-3">
              <Icon name="help" size="lg" />
              Mogu li registrovati vozilo sa isteklom registracijom?
            </span>
            <Icon name="expand_more" class="transition duration-300 group-open:rotate-180" />
          </summary>
          <p class="text-gray-600 mt-4 ml-10">Da, možete. Postupak je isti kao i za redovno produženje registracije. Imajte u vidu da je vožnja sa isteklom registracijom prekršaj i da se ne preporučuje dolazak vozilom — koristite šlep službu ili privremene tablice.</p>
        </details>

        <details class="bg-white rounded-lg shadow-md hover:shadow-lg transition duration-300 p-6 group cursor-pointer border">
          <summary class="flex items-center justify-between font-bold text-primary">
            <span class="flex items-center gap-3">
              <Icon name="help" size="lg" />
              Da li mogu registrovati vozilo unapred?
            </span>
            <Icon name="expand_more" class="transition duration-300 group-open:rotate-180" />
          </summary>
          <p class="text-gray-600 mt-4 ml-10">Da, registraciju možete produžiti do 30 dana pre isteka važeće registracije. Preporučujemo da ne čekate poslednji dan kako biste izbegli gužve.</p>
        </details>

        <details class="bg-white rounded-lg shadow-md hover:shadow-lg transition duration-300 p-6 group cursor-pointer border">
          <summary class="flex items-center justify-between font-bold text-primary">
            <span class="flex items-center gap-3">
              <Icon name="help" size="lg" />
              Da li nudite osiguranje na licu mesta?
            </span>
            <Icon name="expand_more" class="transition duration-300 group-open:rotate-180" />
          </summary>
          <p class="text-gray-600 mt-4 ml-10">Da, na svim našim lokacijama možete zaključiti polisu obaveznog osiguranja. Sarađujemo sa više osiguravajućih kuća tako da možete izabrati najpovoljniju ponudu.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center text-primary mb-8 animate-fadeIn">
        Ostale usluge
      </h2>
      <p class="text-center text-gray-600 mb-12">
        Pored registracije, nudimo i samostalan tehnički pregled vozila na svim lokacijama.
      </p>
      <div class="flex justify-center gap-6 flex-wrap">
        <a href={getPath('/tehnicki-pregled-beograd', baseUrl)} class="bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-6 transition group max-w-sm">
          <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition">Tehnički pregled →</h3>
          <p class="text-gray-600 text-sm">Brz i profesionalan tehnički pregled vozila na tri lokacije u Beogradu.</p>
        </a>
        <a href={getPath('/usluge', baseUrl)} class="bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-lg p-6 transition group max-w-sm">
          <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition">Sve usluge →</h3>
          <p class="text-gray-600 text-sm">Pregledajte kompletnu listu naših usluga i cene.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-4xl mx-auto px-4 text-center animate-slideUp">
      <h2 class="text-3xl font-bold mb-4">
        Registrujte vozilo bez komplikacija
      </h2>
      <p class="text-lg mb-8 text-blue-100">
        Tehnički pregled, osiguranje i registracija — sve na jednom mestu, na jednoj od naših 3 lokacije.
      </p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a
          href="tel:+381112101111"
          class="inline-flex items-center gap-2 bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105"
        >
          <Icon name="phone" />
          Pozovite nas
        </a>
        <a
          href={getPath('/kontakt', baseUrl)}
          class="inline-flex items-center gap-2 bg-white/20 hover:bg-white/30 text-white font-bold py-3 px-8 rounded-lg transition"
        >
          <Icon name="mail" />
          Kontakt forma
        </a>
      </div>
    </div>
  </section>

  <!-- Schema.org Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(
      {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: 'Registracija vozila Beograd',
        description: 'Kompletna registracija vozila u Beogradu na 3 lokacije - tehnički pregled, osiguranje i registracione nalepnice na jednom mestu.',
        serviceType: 'Registracija vozila',
        url: pageUrl,
        areaServed: {
          '@type': 'City',
          name: 'Beograd',
          '@id': 'https://www.wikidata.org/wiki/Q3711',
        },
        provider: {
          '@type': 'AutoRepair',
          name: 'Prvi Balkan - Tehnički Pregled',
          url: siteUrl,
          telephone: '+381112101111',
          priceRange: '$$',
          address: locations.map((loc) => ({
            '@type': 'PostalAddress',
            streetAddress: loc.address,
            addressLocality: 'Beograd',
            addressCountry: 'RS',
          })),
          department: locations.map((loc) => ({
