---
import {
  getPath,
  formatPhoneHref,
  formatWorkingHours,
} from '../../utils/navigation';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Footer from '../../components/Footer.astro';
import { getSettings, getLocations } from '../../utils/strapi';

const baseUrl = import.meta.env.BASE_URL;
const strapiUrl = import.meta.env.STRAPI_URL || 'http://localhost:1337';
const settings = await getSettings();
const locations = await getLocations();

// Use settings with fallbacks
const phone = settings?.phone || '+381 11 2101 111';
const phoneHref = formatPhoneHref(phone);
const email = settings?.email || 'info@prvi-balkan.rs';
const whatsapp = settings?.whatsappPhone || '+38161 11 44444';
---

<Layout
  title="Kontakt - Prvi Balkan"
  description="Kontaktiraj prvi Balkan - Tehnički pregled vozila"
>
  <div class="pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary mb-8">Kontaktiraj nas</h1>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
        <div>
          <h2 class="text-2xl font-bold text-primary mb-6">Informacije</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <Icon name="phone" class="text-primary flex-shrink-0" />
              <div>
                <h3 class="font-bold text-primary">Telefon</h3>
                <p class="text-gray-600">
                  <a href={`tel:${phoneHref}`} class="hover:text-accent"
                    >{phone}</a
                  >
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <Icon name="email" class="text-primary flex-shrink-0" />
              <div>
                <h3 class="font-bold text-primary">Email</h3>
                <p class="text-gray-600">
                  <a href={`mailto:${email}`} class="hover:text-accent"
                    >{email}</a
                  >
                </p>
              </div>
            </div>
            <div class="flex gap-4">
              <Icon name="schedule" class="text-primary flex-shrink-0" />
              <div>
                <h3 class="font-bold text-primary">Radno vreme</h3>
                {
                  locations
                    .filter((loc) => loc.openingHours)
                    .map((loc) => (
                      <div class="mb-3 last:mb-0">
                        <p class="text-sm font-semibold text-gray-700">
                          {loc.name}
                        </p>
                        {formatWorkingHours(loc.openingHours!).map(
                          ({ title, hours }) => (
                            <p class="text-gray-600 text-sm">
                              {title}: {hours}
                            </p>
                          ),
                        )}
                        <a
                          href={getPath(`/lokacije/${loc.slug}/`, baseUrl)}
                          class="text-accent hover:text-orange-600 text-sm font-medium transition"
                        >
                          Detaljnije →
                        </a>
                      </div>
                    ))
                }
              </div>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-primary mb-6">
            Pošalji nam poruku
          </h2>
          <form
            id="contact-form"
            class="space-y-4"
            data-strapi-url={strapiUrl}
            data-ts={Date.now().toString()}
          >
            <!-- Honeypot field - hidden from real users, bots fill it -->
            <div
              class="absolute opacity-0 -z-10 h-0 overflow-hidden"
              aria-hidden="true"
            >
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div>
              <input
                type="text"
                name="name"
                placeholder="Tvoje ime"
                required
                minlength="2"
                maxlength="100"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-primary"
              />
            </div>
            <div>
              <input
                type="email"
                name="email"
                placeholder="Tvoj email"
                required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-primary"
              />
            </div>
            <div>
              <textarea
                name="message"
                placeholder="Poruka (min. 10 karaktera)"
                rows="5"
                required
                minlength="10"
                maxlength="2000"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-primary"
              ></textarea>
            </div>
            <div
              id="contact-error"
              class="hidden text-red-600 text-sm font-medium"
            >
            </div>
            <button
              id="contact-submit-btn"
              type="submit"
              disabled
              class="w-full bg-accent hover:bg-orange-600 text-white font-bold py-2 px-4 rounded-lg transition disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Pošalji
            </button>
          </form>
          <div id="contact-success" class="hidden text-center py-8">
            <Icon
              name="check_circle"
              class="text-green-500 w-12 h-12 mx-auto mb-4"
            />
            <h3 class="text-xl font-bold text-primary mb-2">Poruka poslata!</h3>
            <p class="text-gray-600">
              Odgovorićemo vam u najkraćem mogućem roku.
            </p>
          </div>
        </div>
      </div>

      <div class="bg-green-50 border-l-4 border-green-500 p-6 rounded">
        <h3 class="text-lg font-bold text-green-900 mb-2">
          <Icon name="chat" class="align-middle mr-2" size="sm" />Brzi Odgovor
          preko WhatsApp-a
        </h3>
        <p class="text-green-800 mb-4">
          Kontaktiraj nas preko WhatsApp-a za brži odgovor.
        </p>
        <a
          href={`https://wa.me/${whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-6 rounded-lg transition"
        >
          Otvori WhatsApp
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  import { initContactForm } from '../../scripts/contactForm';
  initContactForm();
</script>
