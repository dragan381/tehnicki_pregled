---
import { getPath } from '../../utils/navigation';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="Kontakt - Prvi Balkan" description="Kontaktiraj prvi Balkan - Tehnički pregled vozila">
  
  <div class="pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary mb-8">Kontaktiraj nas</h1>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
        <div>
          <h2 class="text-2xl font-bold text-primary mb-6">Informacije</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <span class="material-icons text-primary text-2xl flex-shrink-0">phone</span>
              <div>
                <h3 class="font-bold text-primary">Telefon</h3>
                <p class="text-gray-600"><a href="tel:+381112101111" class="hover:text-accent">+381 11 2101 111</a></p>
              </div>
            </div>
            <div class="flex gap-4">
              <span class="material-icons text-primary text-2xl flex-shrink-0">email</span>
              <div>
                <h3 class="font-bold text-primary">Email</h3>
                <p class="text-gray-600"><a href="mailto:info@prvi-balkan.rs" class="hover:text-accent">info@prvi-balkan.rs</a></p>
              </div>
            </div>
            <div class="flex gap-4">
              <span class="material-icons text-primary text-2xl flex-shrink-0">schedule</span>
              <div>
                <h3 class="font-bold text-primary">Radno vreme</h3>
                <p class="text-gray-600">Ponedjeljak-Petak: 08:00-18:00</p>
                <p class="text-gray-600">Subota: 09:00-15:00</p>
                <p class="text-gray-600">Nedelja: Zatvoreni</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-primary mb-6">Pošalji nam poruku</h2>
          <form class="space-y-4">
            <div>
              <input type="text" placeholder="Tvoje ime" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-primary">
            </div>
            <div>
              <input type="email" placeholder="Tvoj email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-primary">
            </div>
            <div>
              <textarea placeholder="Poruka" rows="5" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-primary"></textarea>
            </div>
            <button type="submit" class="w-full bg-accent hover:bg-orange-600 text-white font-bold py-2 px-4 rounded-lg transition">
              Pošalji
            </button>
          </form>
        </div>
      </div>

      <div class="bg-green-50 border-l-4 border-green-500 p-6 rounded">
        <h3 class="text-lg font-bold text-green-900 mb-2"><span class="material-icons text-lg align-middle mr-2">chat</span>Brzi Odgovor preko WhatsApp-a</h3>
        <p class="text-green-800 mb-4">Kontaktiraj nas preko WhatsApp-a za brži odgovor.</p>
        <a href="https://wa.me/381112101111" target="_blank" rel="noopener noreferrer" class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-6 rounded-lg transition">
          Otvori WhatsApp
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>
