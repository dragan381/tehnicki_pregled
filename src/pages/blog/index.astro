---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getBlogPosts, blocksToText } from '../../utils/strapi';

const posts = await getBlogPosts();

function formatDate(dateStr?: string): string {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('sr-Latn-RS', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<Layout title="Blog - Prvi Balkan" description="Blog - Prvi Balkan">
  <div class="pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-bold text-primary mb-8">Blog</h1>
      <p class="text-lg text-gray-600 mb-12">
        Saveti i članci o tehničkom pregledu vozila.
      </p>

      {
        posts.length === 0 && (
          <p class="text-gray-500 text-center">
            Trenutno nema objavljenih članaka.
          </p>
        )
      }

      <div class="space-y-8">
        {
          posts.map((post) => (
            <article
              class="bg-white rounded-lg shadow-lg p-8"
              data-blog-article
            >
              <h2 class="text-2xl font-bold text-primary mb-2">{post.title}</h2>
              {post.publishedAt && (
                <p class="text-gray-500 mb-4">
                  Objavljeno: {formatDate(post.publishedAt)}
                </p>
              )}
              {post.excerpt && (
                <p class="text-gray-700 mb-4" data-excerpt>
                  {post.excerpt}
                </p>
              )}
              <div
                class="text-gray-700 mb-4 hidden whitespace-pre-line"
                data-content
              >
                {blocksToText(post.content)}
              </div>
              <button
                type="button"
                class="text-accent hover:text-orange-600 font-bold cursor-pointer"
                data-toggle-btn
              >
                Pročitaj više →
              </button>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  document.querySelectorAll('[data-blog-article]').forEach((article) => {
    const btn = article.querySelector('[data-toggle-btn]') as HTMLButtonElement;
    const content = article.querySelector('[data-content]') as HTMLElement;
    const excerpt = article.querySelector(
      '[data-excerpt]',
    ) as HTMLElement | null;
    let expanded = false;

    btn.addEventListener('click', () => {
      expanded = !expanded;
      if (expanded) {
        content.classList.remove('hidden');
        if (excerpt) excerpt.classList.add('hidden');
        btn.textContent = '← Sakrij';
      } else {
        content.classList.add('hidden');
        if (excerpt) excerpt.classList.remove('hidden');
        btn.textContent = 'Pročitaj više →';
      }
    });
  });
</script>
