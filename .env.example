# Environment variables for site configuration
# Copy this file to .env and customize for your deployment environment

# For GitHub Pages (project site): https://github.com/dragan381/tehnicki_pregled
# SITE_URL=https://dragan381.github.io
# BASE_PATH=/tehnicki_pregled

# For custom domain: https://tehnicki-pregled.com
# SITE_URL=https://tehnicki-pregled.com
# BASE_PATH=/

# For localhost development
# SITE_URL=http://localhost:3000
# BASE_PATH=/
