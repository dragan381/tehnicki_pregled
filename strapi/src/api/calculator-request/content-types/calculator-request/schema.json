{
  "kind": "collectionType",
  "collectionName": "calculator_requests",
  "info": {
    "singularName": "calculator-request",
    "pluralName": "calculator-requests",
    "displayName": "Calculator Request"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "year": {
      "type": "string",
      "required": true,
      "maxLength": 4,
      "regex": "^[0-9]{4}$"
    },
    "ccm": {
      "type": "string",
      "required": true,
      "maxLength": 6,
      "regex": "^[0-9]{2,6}$"
    },
    "kw": {
      "type": "string",
      "required": true,
      "maxLength": 5,
      "regex": "^[0-9]{1,5}$"
    },
    "location": {
      "type": "string",
      "required": true,
      "maxLength": 50
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 30,
      "regex": "^[+]?[0-9\\s\\-()]{6,30}$"
    },
    "email": {
      "type": "email"
    },
    "toEmail": {
      "type": "email"
    }
  }
}
