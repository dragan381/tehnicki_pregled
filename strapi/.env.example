# ===========================
# Strapi Backend Environment
# ===========================

# Server
HOST=0.0.0.0
PORT=1337
# Public URL of the self-hosted CMS (Oracle Cloud VM behind Caddy).
# Must match the hostname Caddy holds a certificate for.
PUBLIC_URL=https://prvibalkan-cms.duckdns.org

# Security Keys (generate unique values for production!)
# Use: openssl rand -base64 32
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (production: PostgreSQL running on the same VM)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=your_db_password
# false — Postgres is on localhost, the connection never leaves the machine
DATABASE_SSL=false

# CORS - allowed origins (comma-separated)
# Add your Vercel frontend URL here
CORS_ORIGINS=https://prvibalkan.rs,https://www.prvibalkan.rs,https://tehnicki-pregled.vercel.app,http://localhost:4321

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_REPLY_TO=your_email@gmail.com
